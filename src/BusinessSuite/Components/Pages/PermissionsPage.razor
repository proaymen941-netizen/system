@page "/permissions"
@rendermode InteractiveServer
@inject AuthService Auth
@inject PermissionService PermSvc
@inject AuditService Audit

<PageTitle>الصلاحيات</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">إدارة الصلاحيات</h1>
            <p class="page-subtitle">تحكم تفصيلي بما يستطيع كل مستخدم فعله داخل النظام</p>
        </div>
    </div>

    @if (!Auth.HasRole(UserRole.Admin))
    {
        <div class="error-banner">هذه الشاشة مخصصة لمدير النظام فقط.</div>
    }
    else
    {
        <div class="panel">
            <div class="panel-header">
                <h3>اختر المستخدم</h3>
                <select class="input" style="max-width:300px" @bind="_selectedUserId" @bind:after="OnUserChanged">
                    <option value="0">— اختر مستخدماً —</option>
                    @foreach (var u in _users.Where(u => u.Role != UserRole.Admin))
                    {
                        <option value="@u.Id">@u.FullName (@u.Username) — @RoleAr(u.Role)</option>
                    }
                </select>
            </div>

            @if (_selectedUserId == 0)
            {
                <div class="empty" style="padding:40px;text-align:center">
                    اختر مستخدماً من القائمة أعلاه لعرض وتعديل صلاحياته.
                    <br/><br/>
                    <span class="muted">ملاحظة: المدير لديه جميع الصلاحيات تلقائياً.</span>
                </div>
            }
            else
            {
                <div class="form-grid" style="margin-bottom:16px">
                    <button class="ghost-btn" @onclick="GrantAll">✅ منح كل الصلاحيات</button>
                    <button class="ghost-btn" @onclick="RevokeAll">❌ سحب كل الصلاحيات</button>
                    <button class="ghost-btn" @onclick="ResetToRoleDefaults">🔄 إعادة الضبط حسب الدور</button>
                    <button class="primary-btn" @onclick="Save">💾 حفظ الصلاحيات</button>
                </div>

                @if (!string.IsNullOrEmpty(_msg))
                {
                    <div class="success-banner">@_msg</div>
                }

                @foreach (var grp in PermissionKeys.All.GroupBy(p => p.Group))
                {
                    <div style="margin-bottom:14px">
                        <h4 style="margin:8px 0 6px">@grp.Key</h4>
                        <table class="table-soft striped">
                            <thead><tr><th style="width:60px">مفعل</th><th>الصلاحية</th><th>المفتاح</th></tr></thead>
                            <tbody>
                                @foreach (var p in grp)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" checked="@(_values.GetValueOrDefault(p.Key))" @onchange="e => OnToggle(p.Key, e)" />
                                        </td>
                                        <td>@p.Label</td>
                                        <td dir="ltr"><code>@p.Key</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private List<AppUser> _users = new();
    private int _selectedUserId;
    private Dictionary<string, bool> _values = new();
    private string _msg = "";

    protected override async Task OnInitializedAsync()
    {
        _users = await Auth.GetUsersAsync();
    }

    private async Task OnUserChanged()
    {
        _msg = "";
        if (_selectedUserId == 0) { _values.Clear(); return; }
        var user = _users.First(u => u.Id == _selectedUserId);
        var existing = await PermSvc.GetForUserAsync(_selectedUserId);
        _values = PermissionKeys.All.ToDictionary(p => p.Key, p =>
            existing.FirstOrDefault(e => e.PermissionKey == p.Key)?.IsGranted
            ?? PermissionService.DefaultForRole(user.Role, p.Key));
    }

    private void OnToggle(string key, ChangeEventArgs e)
    {
        _values[key] = (bool)(e.Value ?? false);
    }

    private void GrantAll() { foreach (var k in PermissionKeys.All) _values[k.Key] = true; }
    private void RevokeAll() { foreach (var k in PermissionKeys.All) _values[k.Key] = false; }
    private void ResetToRoleDefaults()
    {
        if (_selectedUserId == 0) return;
        var user = _users.First(u => u.Id == _selectedUserId);
        foreach (var p in PermissionKeys.All)
            _values[p.Key] = PermissionService.DefaultForRole(user.Role, p.Key);
    }

    private async Task Save()
    {
        if (_selectedUserId == 0) return;
        await PermSvc.SetForUserAsync(_selectedUserId, _values);
        var user = _users.First(u => u.Id == _selectedUserId);
        await Audit.LogAsync("تحديث صلاحيات", "النظام", user.Username);
        _msg = "تم حفظ صلاحيات المستخدم بنجاح.";
    }

    private static string RoleAr(UserRole r) => r switch
    {
        UserRole.Admin => "مدير",
        UserRole.Accountant => "محاسب",
        UserRole.Cashier => "كاشير",
        UserRole.Employee => "موظف",
        _ => r.ToString()
    };
}
