@page "/print/sale/{Id:int}"
@layout EmptyLayout
@using BusinessSuite.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> Db
@inject QrCodeService Qr
@inject CompanySettingsService SettingsSvc

@if (_invoice == null)
{
    <p>جارٍ التحميل...</p>
}
else
{
    <div class="invoice-page">
        <div class="invoice-toolbar no-print">
            <button class="btn-primary" onclick="window.print()">🖨️ طباعة</button>
            <a class="btn-secondary" href="/sales">عودة للمبيعات</a>
            @if (_invoice.IsCancelled)
            {
                <span class="tag tag-danger" style="margin-inline-start:auto">⚠️ هذه الفاتورة ملغاة</span>
            }
        </div>

        <div class="invoice-paper @(_invoice.IsCancelled ? "cancelled-stamp" : "")">
            <div class="invoice-head">
                <div>
                    <div style="font-size:2.5rem">@_settings.LogoEmoji</div>
                    <h2 style="margin:6px 0">@_settings.Name</h2>
                    <div class="muted">@_settings.Address</div>
                    <div class="muted" dir="ltr">@_settings.Phone</div>
                    <div class="muted">الرقم الضريبي: @_settings.TaxNumber</div>
                </div>
                <div class="invoice-qr">
                    <img src="@_qrData" alt="QR" />
                    <small>رمز التحقق</small>
                </div>
            </div>

            <hr />

            <div class="invoice-meta">
                <div><strong>فاتورة بيع</strong></div>
                <div>رقم الفاتورة: <strong>@_invoice.InvoiceNumber</strong></div>
                <div>التاريخ: @_invoice.Date.ToString("yyyy-MM-dd HH:mm")</div>
                <div>العميل: @(_invoice.CustomerName)</div>
                <div>طريقة الدفع: @_invoice.PaymentMethod</div>
                <div>حالة الدفع: @PaymentLabel(_invoice.PaymentStatus)</div>
            </div>

            <table class="invoice-items">
                <thead>
                    <tr><th>#</th><th>الصنف</th><th>الكمية</th><th>السعر</th><th>الإجمالي</th></tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var it in _invoice.Items)
                    {
                        <tr>
                            <td>@(i++)</td>
                            <td>@it.ProductName</td>
                            <td>@it.Quantity</td>
                            <td>@it.UnitPrice.ToString("N2")</td>
                            <td>@((it.Quantity * it.UnitPrice).ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="invoice-totals">
                <div><span>المجموع الفرعي:</span><strong>@_invoice.Subtotal.ToString("N2") @_settings.Currency</strong></div>
                <div><span>الضريبة (@_settings.TaxRate%):</span><strong>@_invoice.Tax.ToString("N2") @_settings.Currency</strong></div>
                <div class="grand"><span>الإجمالي:</span><strong>@_invoice.Total.ToString("N2") @_settings.Currency</strong></div>
            </div>

            <div class="invoice-footer">
                <p>شكراً لتعاملكم معنا — @_settings.Name</p>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private SaleInvoice? _invoice;
    private string _qrData = "";
    private CompanySettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsSvc.GetAsync();
        await using var db = Db.CreateDbContext();
        _invoice = await db.SaleInvoices.Include(s => s.Items).FirstOrDefaultAsync(s => s.Id == Id);

        if (_invoice != null)
        {
            var qrText = $"INV:{_invoice.InvoiceNumber}|DATE:{_invoice.Date:yyyy-MM-dd}|TOTAL:{_invoice.Total:N2}|VAT:{_settings.TaxNumber}";
            _qrData = Qr.GenerateBase64Png(qrText, 6);
        }
    }

    private string PaymentLabel(InvoicePaymentStatus s) => s switch
    {
        InvoicePaymentStatus.Paid => "مدفوعة",
        InvoicePaymentStatus.Unpaid => "غير مدفوعة",
        InvoicePaymentStatus.PartiallyPaid => "مدفوعة جزئياً",
        InvoicePaymentStatus.Refunded => "مسترجعة",
        _ => s.ToString(),
    };
}
