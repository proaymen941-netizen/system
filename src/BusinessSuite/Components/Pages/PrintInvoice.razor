@page "/print/sale/{Id:int}"
@layout EmptyLayout
@using BusinessSuite.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> Db
@inject QrCodeService Qr
@inject CompanySettingsService SettingsSvc

@if (_invoice == null)
{
    <p style="text-align:center;padding:2rem">جارٍ التحميل...</p>
}
else
{
    <div class="thermal-toolbar no-print">
        <button onclick="window.print()">🖨️ طباعة</button>
        <a href="/sales">↩ المبيعات</a>
        @if (_invoice.IsCancelled)
        {
            <span style="color:red;font-weight:700">⚠️ هذه الفاتورة ملغاة</span>
        }
    </div>

    <div class="thermal-wrap">
        <div class="thermal-receipt @(_invoice.IsCancelled ? "cancelled-stamp" : "")">

            <div class="tr-header">
                <div class="tr-logo">@_settings.LogoEmoji</div>
                <div class="tr-company">@_settings.Name</div>
                @if (!string.IsNullOrWhiteSpace(_settings.ReceiptHeader))
                {
                    <div class="tr-tagline">@_settings.ReceiptHeader</div>
                }
                @if (!string.IsNullOrWhiteSpace(_settings.Address))
                {
                    <div class="tr-small">@_settings.Address</div>
                }
                @if (!string.IsNullOrWhiteSpace(_settings.Phone))
                {
                    <div class="tr-small" dir="ltr">@_settings.Phone</div>
                }
                @if (!string.IsNullOrWhiteSpace(_settings.TaxNumber))
                {
                    <div class="tr-small">الرقم الضريبي: @_settings.TaxNumber</div>
                }
            </div>

            <div class="tr-divider">━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</div>

            <div class="tr-meta">
                <div class="tr-meta-row">
                    <span>رقم الطلب</span>
                    <strong>#@_invoice.OrderNumber</strong>
                </div>
                <div class="tr-meta-row">
                    <span>رقم الفاتورة</span>
                    <strong>@_invoice.InvoiceNumber</strong>
                </div>
                <div class="tr-meta-row">
                    <span>التاريخ</span>
                    <strong>@_invoice.Date.ToString("yyyy/MM/dd")</strong>
                </div>
                <div class="tr-meta-row">
                    <span>الوقت</span>
                    <strong>@_invoice.Date.ToString("hh:mm tt")</strong>
                </div>
                <div class="tr-meta-row">
                    <span>نوع الطلب</span>
                    <strong class="tr-order-type">@_invoice.OrderType</strong>
                </div>
                <div class="tr-meta-row">
                    <span>الكاشير</span>
                    <strong>@(string.IsNullOrWhiteSpace(_invoice.CashierName) ? "—" : _invoice.CashierName)</strong>
                </div>
                <div class="tr-meta-row">
                    <span>العميل</span>
                    <strong>@_invoice.CustomerName</strong>
                </div>
                <div class="tr-meta-row">
                    <span>طريقة الدفع</span>
                    <strong>@_invoice.PaymentMethod</strong>
                </div>
                @if (_invoice.PaymentStatus == InvoicePaymentStatus.Unpaid)
                {
                    <div class="tr-meta-row" style="color:red">
                        <span>حالة الدفع</span>
                        <strong>آجل ⚠️</strong>
                    </div>
                }
            </div>

            <div class="tr-divider">━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</div>

            <table class="tr-items">
                <thead>
                    <tr>
                        <th class="tr-item-name">الصنف</th>
                        <th class="tr-item-qty">كمية</th>
                        <th class="tr-item-price">سعر</th>
                        <th class="tr-item-total">مجموع</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var it in _invoice.Items)
                    {
                        <tr>
                            <td class="tr-item-name">@it.ProductName</td>
                            <td class="tr-item-qty">@it.Quantity</td>
                            <td class="tr-item-price">@it.UnitPrice.ToString("N2")</td>
                            <td class="tr-item-total">@it.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="tr-divider">━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</div>

            <div class="tr-totals">
                <div class="tr-total-row">
                    <span>المجموع الفرعي</span>
                    <span>@_invoice.Subtotal.ToString("N2") @_settings.Currency</span>
                </div>
                @if (_settings.ShowTaxOnReceipt)
                {
                    <div class="tr-total-row">
                        <span>ضريبة (@_settings.TaxRate%)</span>
                        <span>@_invoice.Tax.ToString("N2") @_settings.Currency</span>
                    </div>
                }
                <div class="tr-total-row grand">
                    <span>الإجمالي</span>
                    <span>@_invoice.Total.ToString("N2") @_settings.Currency</span>
                </div>
            </div>

            @if (_settings.ShowQrOnReceipt && !string.IsNullOrEmpty(_qrData))
            {
                <div class="tr-divider">━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</div>
                <div class="tr-qr">
                    <img src="@_qrData" alt="QR" width="90" height="90" />
                    <div class="tr-small">رمز التحقق الضريبي</div>
                </div>
            }

            <div class="tr-divider">━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</div>

            <div class="tr-footer">
                @if (!string.IsNullOrWhiteSpace(_settings.ReceiptFooter))
                {
                    <div>@_settings.ReceiptFooter</div>
                }
                <div class="tr-small" style="margin-top:.3rem">@_settings.Name — @_invoice.Date.ToString("yyyy")</div>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private SaleInvoice? _invoice;
    private string _qrData = "";
    private CompanySettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsSvc.GetAsync();
        await using var db = Db.CreateDbContext();
        _invoice = await db.SaleInvoices.Include(s => s.Items).FirstOrDefaultAsync(s => s.Id == Id);

        if (_invoice != null && _settings.ShowQrOnReceipt)
        {
            var qrText = $"INV:{_invoice.InvoiceNumber}|DATE:{_invoice.Date:yyyy-MM-dd}|TOTAL:{_invoice.Total:N2}|VAT:{_settings.TaxNumber}";
            _qrData = Qr.GenerateBase64Png(qrText, 5);
        }
    }
}
