@page "/monthly-absence"
@rendermode InteractiveServer
@inject HrExtendedService HrExt
@inject HrService HrSvc
@inject AuthService Auth
@inject AuditService Audit

<PageTitle>الغياب الشهري</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">الغياب الشهري</h1>
            <p class="page-subtitle">تسجيل أيام الغياب والتأخير والساعات الإضافية لكل موظف شهرياً</p>
        </div>
    </div>

    <div class="panel">
        <div class="form-grid">
            <label>السنة<input class="input" type="number" @bind="_year" @bind:after="Refresh" /></label>
            <label>الشهر
                <select class="input" @bind="_month" @bind:after="Refresh">
                    @for (int m = 1; m <= 12; m++) { <option value="@m">@m</option> }
                </select>
            </label>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h3>@_year/@_month — سجلات الغياب</h3>
        </div>
        <table class="table-soft striped">
            <thead><tr><th>الموظف</th><th>أيام الغياب</th><th>أيام التأخير</th><th>ساعات إضافية</th><th>الخصم</th><th>ملاحظات</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in _employees)
                {
                    var rec = _list.FirstOrDefault(a => a.EmployeeId == e.Id) ?? new MonthlyAbsence { EmployeeId = e.Id, Year = _year, Month = _month };
                    <tr>
                        <td>@e.Name</td>
                        <td><input class="input" type="number" @bind="rec.AbsentDays" /></td>
                        <td><input class="input" type="number" @bind="rec.LateDays" /></td>
                        <td><input class="input" type="number" @bind="rec.OvertimeHours" /></td>
                        <td><input class="input" type="number" step="0.01" @bind="rec.DeductionAmount" /></td>
                        <td><input class="input" @bind="rec.Notes" /></td>
                        <td>
                            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant))
                            {
                                <button class="primary-btn" @onclick="() => Save(rec)">حفظ</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private List<Employee> _employees = new();
    private List<MonthlyAbsence> _list = new();

    protected override async Task OnInitializedAsync()
    {
        _employees = await HrSvc.GetEmployeesAsync();
        await Refresh();
    }

    private async Task Refresh() => _list = await HrExt.GetAbsencesAsync(_year, _month);

    private async Task Save(MonthlyAbsence rec)
    {
        rec.Year = _year; rec.Month = _month;
        await HrExt.SaveAbsenceAsync(rec);
        await Audit.LogAsync("حفظ غياب شهري", "الموارد البشرية", $"موظف #{rec.EmployeeId} {_year}/{_month}");
        await Refresh();
    }
}
