@page "/inventory"
@rendermode InteractiveServer
@inject InventoryService InvSvc

<PageTitle>إدارة المخازن</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">إدارة المخازن</h1>
            <p class="page-subtitle">إضافة بضائع للمخازن وإدارة الكميات والتنبيهات</p>
        </div>
        <div class="page-header-actions">
            <button class="ghost-btn" @onclick="StartStockOnly" title="زيادة كمية لصنف موجود في المخزن">📥 إدخال بضاعة للمخزن</button>
            <button class="primary-btn" @onclick="StartNew">+ صنف جديد بالمخزن</button>
        </div>
    </div>

    <div class="info-banner">
        ℹ️ هذه الصفحة تخصّ <strong>إدخال البضاعة للمخازن</strong> فقط. لإضافة منتج إلى شاشة <strong>الكاشير</strong> برقم تشغيل، استخدم زر "+ صنف جديد بالمخزن" واملأ حقل <strong>رقم المنتج بالكاشير</strong>.
    </div>

    <div class="grid-2">
        <div class="panel">
            <div class="panel-header"><h3>قائمة الأصناف</h3><input class="input-search" placeholder="بحث..." @bind="_search" @bind:event="oninput" /></div>
            <table class="table-soft striped">
                <thead><tr><th>رقم الكاشير</th><th>الصنف</th><th>الكود</th><th>الفئة</th><th>السعر</th><th>الكمية</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in Filtered)
                    {
                        <tr>
                            <td>@(p.DisplayNumber > 0 ? "#" + p.DisplayNumber : "—")</td>
                            <td><span class="emoji">@p.ImageEmoji</span> @p.Name</td>
                            <td>@p.Sku</td>
                            <td>@p.Category</td>
                            <td>@p.Price.ToString("N2")</td>
                            <td>
                                @p.Quantity
                                @if (p.Quantity <= p.MinQuantity)
                                {
                                    <span class="tag tag-danger small">منخفض</span>
                                }
                            </td>
                            <td>
                                <button class="link" @onclick="() => AddStock(p)" title="زيادة كمية بالمخزن">+ بضاعة</button>
                                <button class="link" @onclick="() => Edit(p)">تعديل</button>
                                <button class="link danger" @onclick="() => Delete(p.Id)">حذف</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="panel">
            <div class="panel-header"><h3>تنبيهات المخزون</h3></div>
            <table class="table-soft">
                <thead><tr><th>الصنف</th><th>الكمية</th><th>الحد الأدنى</th></tr></thead>
                <tbody>
                    @foreach (var p in _products.Where(x => x.Quantity <= x.MinQuantity))
                    {
                        <tr>
                            <td><span class="emoji">@p.ImageEmoji</span> @p.Name</td>
                            <td><span class="tag tag-danger">@p.Quantity</span></td>
                            <td>@p.MinQuantity</td>
                        </tr>
                    }
                    @if (!_products.Any(x => x.Quantity <= x.MinQuantity))
                    {
                        <tr><td colspan="3" class="muted">لا توجد تنبيهات</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_editing != null)
    {
        <div class="modal-overlay" @onclick="Cancel">
            <div class="modal" @onclick:stopPropagation="true">
                <h3>@(_editing.Id == 0 ? "صنف جديد بالمخزن" : "تعديل صنف")</h3>
                <EditForm Model="_editing" OnValidSubmit="Save">
                    <div class="form-grid">
                        <label>
                            <span>رقم المنتج بالكاشير <span class="muted-hint">(يُستخدم بالكيبورد)</span></span>
                            <input class="input" type="number" min="1" @bind="_editing.DisplayNumber" />
                        </label>
                        <label>الاسم<input class="input" @bind="_editing.Name" required /></label>
                        <label>الكود (باركود)<input class="input" @bind="_editing.Sku" /></label>
                        <label>الفئة<input class="input" @bind="_editing.Category" /></label>
                        <label>الرمز<input class="input" @bind="_editing.ImageEmoji" /></label>
                        <label>السعر<input class="input" type="number" step="0.01" @bind="_editing.Price" /></label>
                        <label>التكلفة<input class="input" type="number" step="0.01" @bind="_editing.Cost" /></label>
                        <label>الكمية بالمخزن<input class="input" type="number" @bind="_editing.Quantity" /></label>
                        <label>الحد الأدنى<input class="input" type="number" @bind="_editing.MinQuantity" /></label>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="ghost-btn" @onclick="Cancel">إلغاء</button>
                        <button type="submit" class="primary-btn">حفظ</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (_stockTarget != null)
    {
        <div class="modal-overlay" @onclick="() => _stockTarget = null">
            <div class="modal" style="max-width:420px" @onclick:stopPropagation="true">
                <h3>📥 إدخال بضاعة للمخزن</h3>
                <div class="form-grid">
                    <div class="full" style="background:#f8fafc;padding:.6rem .8rem;border-radius:8px">
                        <div><strong>@_stockTarget.Name</strong></div>
                        <div class="muted" style="font-size:.85rem">رقم الكاشير: @(_stockTarget.DisplayNumber > 0 ? "#" + _stockTarget.DisplayNumber : "—") • الكمية الحالية: @_stockTarget.Quantity</div>
                    </div>
                    <label class="full">الكمية المضافة للمخزن<input class="input" type="number" min="1" @bind="_stockAddQty" /></label>
                    <label class="full">ملاحظة (اختياري)<input class="input" @bind="_stockAddNote" placeholder="مثلاً: مورد رقم..." /></label>
                </div>
                <div class="modal-actions">
                    <button class="ghost-btn" @onclick="() => _stockTarget = null">إلغاء</button>
                    <button class="primary-btn" @onclick="ConfirmAddStock">إضافة للمخزن</button>
                </div>
            </div>
        </div>
    }

    @if (_stockSelectorOpen)
    {
        <div class="modal-overlay" @onclick="() => _stockSelectorOpen = false">
            <div class="modal" style="max-width:520px" @onclick:stopPropagation="true">
                <h3>📥 إدخال بضاعة — اختر الصنف</h3>
                <input class="input" placeholder="بحث بالاسم أو الكود..." @bind="_stockSearch" @bind:event="oninput" />
                <div style="max-height:50vh;overflow:auto;margin-top:.5rem">
                    <table class="table-soft striped">
                        <thead><tr><th>رقم</th><th>الصنف</th><th>الكمية</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in StockSelectorList)
                            {
                                <tr>
                                    <td>@(p.DisplayNumber > 0 ? "#" + p.DisplayNumber : "—")</td>
                                    <td>@p.ImageEmoji @p.Name</td>
                                    <td>@p.Quantity</td>
                                    <td><button class="primary-btn" @onclick="() => SelectForStock(p)">اختيار</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-actions">
                    <button class="ghost-btn" @onclick="() => _stockSelectorOpen = false">إغلاق</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Product> _products = new();
    private string _search = "";
    private Product? _editing;

    private Product? _stockTarget;
    private int _stockAddQty = 1;
    private string _stockAddNote = "";
    private bool _stockSelectorOpen;
    private string _stockSearch = "";

    protected override async Task OnInitializedAsync() => _products = await InvSvc.GetProductsAsync();

    private IEnumerable<Product> Filtered =>
        (string.IsNullOrWhiteSpace(_search) ? _products :
            _products.Where(p => p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || p.Sku.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(p => p.DisplayNumber == 0 ? int.MaxValue : p.DisplayNumber)
        .ThenBy(p => p.Name);

    private IEnumerable<Product> StockSelectorList =>
        (string.IsNullOrWhiteSpace(_stockSearch) ? _products :
            _products.Where(p => p.Name.Contains(_stockSearch, StringComparison.OrdinalIgnoreCase) || p.Sku.Contains(_stockSearch, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(p => p.DisplayNumber == 0 ? int.MaxValue : p.DisplayNumber)
        .ThenBy(p => p.Name);

    private async Task StartNew()
    {
        _editing = new Product { ImageEmoji = "📦" };
        _editing.DisplayNumber = await InvSvc.GetNextDisplayNumberAsync();
    }

    private void Edit(Product p) => _editing = new Product
    {
        Id = p.Id, Name = p.Name, Sku = p.Sku, Category = p.Category, Price = p.Price,
        Cost = p.Cost, Quantity = p.Quantity, MinQuantity = p.MinQuantity,
        ImageEmoji = p.ImageEmoji, DisplayNumber = p.DisplayNumber
    };
    private void Cancel() => _editing = null;

    private async Task Save()
    {
        if (_editing == null) return;
        await InvSvc.SaveProductAsync(_editing);
        _editing = null;
        _products = await InvSvc.GetProductsAsync();
    }

    private async Task Delete(int id)
    {
        await InvSvc.DeleteProductAsync(id);
        _products = await InvSvc.GetProductsAsync();
    }

    private void StartStockOnly() { _stockSelectorOpen = true; _stockSearch = ""; }
    private void SelectForStock(Product p) { _stockSelectorOpen = false; AddStock(p); }

    private void AddStock(Product p)
    {
        _stockTarget = p;
        _stockAddQty = 1;
        _stockAddNote = "";
    }

    private async Task ConfirmAddStock()
    {
        if (_stockTarget == null || _stockAddQty <= 0) return;
        var fresh = await InvSvc.GetProductAsync(_stockTarget.Id);
        if (fresh == null) { _stockTarget = null; return; }
        fresh.Quantity += _stockAddQty;
        await InvSvc.SaveProductAsync(fresh);
        _stockTarget = null;
        _products = await InvSvc.GetProductsAsync();
    }
}
