@page "/import"
@rendermode InteractiveServer
@inject InventoryService Inv
@inject AuthService Auth
@inject AuditService Audit

<PageTitle>استيراد البيانات</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">استيراد البيانات</h1>
            <p class="page-subtitle">رفع منتجات من ملف CSV</p>
        </div>
    </div>

    @if (!Auth.HasRole(UserRole.Admin))
    {
        <div class="error-banner">⚠️ هذه الصفحة متاحة لمدير النظام فقط</div>
    }
    else
    {
        <div class="panel">
            <div class="panel-header"><h3>استيراد منتجات (CSV)</h3></div>
            <div style="padding:16px">
                <p>الصيغة المطلوبة (الترتيب): <code>Name,Sku,Category,Price,Cost,Quantity,MinQuantity,Emoji</code></p>
                <p class="muted">السطر الأول يعتبر عنواناً ويتم تجاهله. الأسعار والكميات بالأرقام فقط. يتم التحديث حسب SKU الفريد.</p>
                <div style="display:flex;gap:12px;align-items:center;margin-top:8px">
                    <InputFile OnChange="OnFileSelected" accept=".csv" class="input" />
                    <a class="ghost-btn" href="/sample/products.csv" target="_blank">⬇️ نموذج CSV</a>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_error)) { <div class="error-banner">@_error</div> }
            @if (!string.IsNullOrEmpty(_message)) { <div class="success-banner">@_message</div> }

            @if (_preview.Any())
            {
                <table class="table-soft striped">
                    <thead><tr><th>#</th><th>الاسم</th><th>SKU</th><th>الفئة</th><th>السعر</th><th>التكلفة</th><th>الكمية</th><th>الحد الأدنى</th></tr></thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var p in _preview)
                        {
                            <tr>
                                <td>@(i++)</td>
                                <td>@p.Name</td>
                                <td>@p.Sku</td>
                                <td>@p.Category</td>
                                <td>@p.Price.ToString("N2")</td>
                                <td>@p.Cost.ToString("N2")</td>
                                <td>@p.Quantity</td>
                                <td>@p.MinQuantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="modal-actions" style="justify-content:flex-end;padding:12px">
                    <button class="ghost-btn" @onclick="() => _preview.Clear()">إلغاء</button>
                    <button class="primary-btn" @onclick="Confirm">✅ تأكيد الاستيراد (@_preview.Count صنف)</button>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Product> _preview = new();
    private string _message = "";
    private string _error = "";

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _message = ""; _error = ""; _preview.Clear();
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 5_000_000);
            using var reader = new StreamReader(stream);
            string? line; int lineNo = 0;
            while ((line = await reader.ReadLineAsync()) != null)
            {
                lineNo++;
                if (lineNo == 1) continue;
                if (string.IsNullOrWhiteSpace(line)) continue;
                var parts = ParseCsvLine(line);
                if (parts.Count < 7) continue;
                _preview.Add(new Product
                {
                    Name = parts[0].Trim(),
                    Sku = parts[1].Trim(),
                    Category = parts[2].Trim(),
                    Price = decimal.TryParse(parts[3], out var pr) ? pr : 0,
                    Cost = decimal.TryParse(parts[4], out var co) ? co : 0,
                    Quantity = int.TryParse(parts[5], out var q) ? q : 0,
                    MinQuantity = int.TryParse(parts[6], out var mq) ? mq : 0,
                    ImageEmoji = parts.Count > 7 ? parts[7].Trim() : "📦",
                });
            }
            if (!_preview.Any()) _error = "لم يتم العثور على بيانات صالحة في الملف";
        }
        catch (Exception ex) { _error = "خطأ في قراءة الملف: " + ex.Message; }
    }

    private async Task Confirm()
    {
        try
        {
            await Inv.ImportProductsAsync(_preview);
            await Audit.LogAsync("استيراد منتجات", "المخازن", $"{_preview.Count} صنف");
            _message = $"✅ تم استيراد {_preview.Count} صنف بنجاح";
            _preview.Clear();
        }
        catch (AuthorizationException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = "خطأ: " + ex.Message; }
    }

    private static List<string> ParseCsvLine(string line)
    {
        var result = new List<string>();
        var current = new System.Text.StringBuilder();
        bool inQuotes = false;
        for (int i = 0; i < line.Length; i++)
        {
            var c = line[i];
            if (c == '"') inQuotes = !inQuotes;
            else if (c == ',' && !inQuotes) { result.Add(current.ToString()); current.Clear(); }
            else current.Append(c);
        }
        result.Add(current.ToString());
        return result;
    }
}
