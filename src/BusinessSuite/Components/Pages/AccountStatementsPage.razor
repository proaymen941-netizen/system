@page "/account-statements"
@rendermode InteractiveServer
@inject AccountingExtendedService AccSvc
@inject CustomerService CustSvc
@inject HrService HrSvc
@using BusinessSuite.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>كشوف الحسابات</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">كشوف الحسابات</h1>
            <p class="page-subtitle">كشف حساب عميل / مورد / موظف مع الأرصدة المتجمعة</p>
        </div>
    </div>

    <div class="panel">
        <div class="form-grid">
            <label>نوع الكشف
                <select class="input" @bind="_kind" @bind:after="OnKindChanged">
                    <option value="customer">كشف حساب عميل</option>
                    <option value="supplier">كشف حساب مورد</option>
                    <option value="employee">كشف حساب موظف</option>
                </select>
            </label>
            <label>الجهة
                <select class="input" @bind="_partyId">
                    <option value="0">— اختر —</option>
                    @foreach (var o in _options) { <option value="@o.Id">@o.Name</option> }
                </select>
            </label>
            <label>من تاريخ<input class="input" type="date" @bind="_from" /></label>
            <label>إلى تاريخ<input class="input" type="date" @bind="_to" /></label>
            <label>&nbsp;<button class="primary-btn" @onclick="Load">عرض الكشف</button></label>
        </div>
    </div>

    @if (_rows.Any())
    {
        <div class="panel">
            <div class="panel-header">
                <h3>@HeaderTitle (@_rows.Count حركة)</h3>
                <button class="ghost-btn" @onclick="Print">🖨️ طباعة</button>
            </div>
            <table class="table-soft striped">
                <thead><tr><th>التاريخ</th><th>المرجع</th><th>الوصف</th><th>مدين</th><th>دائن</th><th>الرصيد</th></tr></thead>
                <tbody>
                    @foreach (var r in _rows)
                    {
                        <tr>
                            <td>@r.Date.ToString("yyyy-MM-dd")</td>
                            <td>@r.Reference</td>
                            <td>@r.Description</td>
                            <td>@r.Debit.ToString("N2")</td>
                            <td>@r.Credit.ToString("N2")</td>
                            <td><strong>@r.Balance.ToString("N2")</strong></td>
                        </tr>
                    }
                    <tr>
                        <td colspan="3"><strong>الإجمالي</strong></td>
                        <td><strong>@_rows.Sum(r => r.Debit).ToString("N2")</strong></td>
                        <td><strong>@_rows.Sum(r => r.Credit).ToString("N2")</strong></td>
                        <td><strong>@(_rows.LastOrDefault()?.Balance.ToString("N2") ?? "0.00")</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    else if (_loaded)
    {
        <div class="panel"><div class="empty">لا توجد حركات للجهة المختارة في الفترة المحددة.</div></div>
    }
</div>

@code {
    private string _kind = "customer";
    private int _partyId;
    private DateTime? _from = DateTime.Today.AddMonths(-3);
    private DateTime? _to = DateTime.Today;
    private List<StatementRow> _rows = new();
    private bool _loaded;
    private List<(int Id, string Name)> _options = new();

    private string HeaderTitle => _kind switch
    {
        "customer" => $"كشف حساب العميل: {_options.FirstOrDefault(o => o.Id == _partyId).Name}",
        "supplier" => $"كشف حساب المورد: {_options.FirstOrDefault(o => o.Id == _partyId).Name}",
        "employee" => $"كشف حساب الموظف: {_options.FirstOrDefault(o => o.Id == _partyId).Name}",
        _ => "كشف حساب"
    };

    protected override async Task OnInitializedAsync() => await OnKindChanged();

    private async Task OnKindChanged()
    {
        _partyId = 0; _rows.Clear(); _loaded = false;
        if (_kind == "customer")
        {
            var list = await CustSvc.GetAsync();
            _options = list.Select(c => (c.Id, c.Name)).ToList();
        }
        else if (_kind == "supplier")
        {
            await using var db = DbFactory.CreateDbContext();
            var list = await db.Suppliers.OrderBy(s => s.Name).ToListAsync();
            _options = list.Select(s => (s.Id, s.Name)).ToList();
        }
        else
        {
            var list = await HrSvc.GetEmployeesAsync();
            _options = list.Select(e => (e.Id, e.Name)).ToList();
        }
    }

    private async Task Load()
    {
        if (_partyId == 0) { _rows.Clear(); _loaded = true; return; }
        _rows = _kind switch
        {
            "customer" => await AccSvc.GetCustomerStatementAsync(_partyId, _from, _to),
            "supplier" => await AccSvc.GetSupplierStatementAsync(_partyId, _from, _to),
            "employee" => await AccSvc.GetEmployeeStatementAsync(_partyId, _from, _to),
            _ => new()
        };
        _loaded = true;
    }

    private void Print() { /* prints via browser */ }
}
