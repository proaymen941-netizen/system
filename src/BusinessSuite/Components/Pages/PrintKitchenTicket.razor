@page "/print/kitchen/{Id:int}"
@layout EmptyLayout
@using BusinessSuite.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> Db
@inject CompanySettingsService SettingsSvc

@if (_invoice == null)
{
    <p style="text-align:center;padding:2rem">جارٍ التحميل...</p>
}
else
{
    <div class="thermal-toolbar no-print">
        <button onclick="window.print()">🖨️ طباعة قصاصة المطبخ</button>
        <a href="/pos">↩ الكاشير</a>
    </div>

    <div class="thermal-wrap">
        <div class="kitchen-ticket">

            <div class="kt-header">
                <div class="kt-title">قصاصة المطبخ</div>
                <div class="kt-order-num">#@_invoice.OrderNumber</div>
                <div class="kt-order-type">@_invoice.OrderType</div>
            </div>

            <div class="kt-divider">━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</div>

            <div class="kt-meta">
                <div class="kt-meta-row">
                    <span>الوقت</span>
                    <strong>@_invoice.Date.ToString("hh:mm tt")</strong>
                </div>
                <div class="kt-meta-row">
                    <span>التاريخ</span>
                    <strong>@_invoice.Date.ToString("yyyy/MM/dd")</strong>
                </div>
                <div class="kt-meta-row">
                    <span>الكاشير</span>
                    <strong>@(string.IsNullOrWhiteSpace(_invoice.CashierName) ? "—" : _invoice.CashierName)</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(_invoice.Notes))
                {
                    <div class="kt-meta-row">
                        <span>ملاحظات</span>
                        <strong>@_invoice.Notes</strong>
                    </div>
                }
            </div>

            <div class="kt-divider">━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</div>

            <table class="kt-items">
                <tbody>
                    @foreach (var it in _invoice.Items)
                    {
                        <tr>
                            <td class="kt-qty">× @it.Quantity</td>
                            <td class="kt-name">@it.ProductName</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="kt-divider">━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</div>

            <div class="kt-footer">
                <div>@_settings.Name</div>
                <div class="kt-small">فاتورة: @_invoice.InvoiceNumber</div>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private SaleInvoice? _invoice;
    private CompanySettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsSvc.GetAsync();
        await using var db = Db.CreateDbContext();
        _invoice = await db.SaleInvoices.Include(s => s.Items).FirstOrDefaultAsync(s => s.Id == Id);
    }
}
