@page "/sales-returns"
@rendermode InteractiveServer
@inject OperationsExtendedService OpsSvc
@inject InventoryService InvSvc
@inject CustomerService CustSvc
@inject AuthService Auth
@inject AuditService Audit

<PageTitle>مرتجع المبيعات</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">مرتجع المبيعات</h1>
            <p class="page-subtitle">إعادة بضائع من العميل واسترجاع المبلغ ورفع المخزون</p>
        </div>
        <div class="page-header-actions">
            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant, UserRole.Cashier))
            {
                <button class="primary-btn" @onclick="StartNew">+ مرتجع جديد</button>
            }
        </div>
    </div>

    <div class="stat-grid stat-grid-3">
        <div class="stat-card stat-orange"><div class="stat-icon">↩️</div><div class="stat-body"><div class="stat-label">مرتجعات</div><div class="stat-value">@_list.Count</div></div></div>
        <div class="stat-card stat-blue"><div class="stat-icon">📦</div><div class="stat-body"><div class="stat-label">قطع مرتجعة</div><div class="stat-value">@_list.Sum(r => r.Items.Sum(i => i.Quantity))</div></div></div>
        <div class="stat-card stat-purple"><div class="stat-icon">💰</div><div class="stat-body"><div class="stat-label">إجمالي المرتجعات</div><div class="stat-value">@_list.Sum(r => r.Total).ToString("N2")</div></div></div>
    </div>

    <div class="panel">
        <table class="table-soft striped">
            <thead><tr><th>الرقم</th><th>التاريخ</th><th>العميل</th><th>الفاتورة الأصلية</th><th>الإجمالي</th><th>السبب</th><th></th></tr></thead>
            <tbody>
                @if (!_list.Any()) { <tr><td colspan="7" class="empty">لا توجد مرتجعات</td></tr> }
                @foreach (var r in _list)
                {
                    <tr>
                        <td><strong>@r.ReturnNumber</strong></td>
                        <td>@r.Date.ToString("yyyy-MM-dd")</td>
                        <td>@r.CustomerName</td>
                        <td>@r.OriginalInvoiceNumber</td>
                        <td><strong>@r.Total.ToString("N2")</strong></td>
                        <td>@r.Reason</td>
                        <td>
                            @if (Auth.HasRole(UserRole.Admin))
                            {
                                <button class="link danger" @onclick="() => Delete(r.Id)">حذف</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_editing != null)
    {
        <div class="modal-overlay" @onclick="() => _editing = null">
            <div class="modal" style="max-width:900px" @onclick:stopPropagation="true">
                <h3>مرتجع مبيعات جديد</h3>
                <div class="form-grid">
                    <label>التاريخ<input class="input" type="date" @bind="_editing.Date" /></label>
                    <label>العميل
                        <select class="input" @bind="_editing.CustomerId">
                            <option value="0">— نقدي —</option>
                            @foreach (var c in _customers) { <option value="@c.Id">@c.Name</option> }
                        </select>
                    </label>
                    <label>اسم العميل<input class="input" @bind="_editing.CustomerName" /></label>
                    <label>رقم الفاتورة الأصلية<input class="input" @bind="_editing.OriginalInvoiceNumber" /></label>
                    <label>طريقة الاسترداد
                        <select class="input" @bind="_editing.RefundMethod">
                            <option value="نقدي">نقدي</option>
                            <option value="رصيد">رصيد للعميل</option>
                            <option value="تحويل">تحويل بنكي</option>
                        </select>
                    </label>
                    <label class="full">السبب<input class="input" @bind="_editing.Reason" /></label>
                </div>

                <h4>الأصناف المرتجعة</h4>

                <div class="return-quickadd">
                    <div class="return-quickadd-title">⌨️ إضافة سريعة برقم المنتج</div>
                    <div class="return-quickadd-row">
                        <input class="input" type="number" min="1" placeholder="رقم المنتج"
                               @bind="_quickNumber" @onkeyup="OnQuickKey" />
                        <button class="primary-btn" @onclick="AddByNumber">إضافة</button>
                        @if (!string.IsNullOrEmpty(_quickError))
                        {
                            <span class="return-quick-error">@_quickError</span>
                        }
                        @if (!string.IsNullOrEmpty(_quickInfo))
                        {
                            <span class="return-quick-ok">@_quickInfo</span>
                        }
                    </div>
                </div>

                <table class="table-soft">
                    <thead><tr><th>#</th><th>الصنف</th><th>الكمية</th><th>السعر</th><th>الإجمالي</th><th></th></tr></thead>
                    <tbody>
                        @for (int i = 0; i < _editing.Items.Count; i++)
                        {
                            var idx = i;
                            var it = _editing.Items[idx];
                            var prod = _products.FirstOrDefault(p => p.Id == it.ProductId);
                            <tr>
                                <td>@(prod?.DisplayNumber > 0 ? "#" + prod.DisplayNumber : "—")</td>
                                <td>
                                    <select class="input" @bind="it.ProductId" @bind:after="() => OnProductChanged(idx)">
                                        <option value="0">— اختر —</option>
                                        @foreach (var p in _products) { <option value="@p.Id">@(p.DisplayNumber > 0 ? $"#{p.DisplayNumber} — " : "") @p.Name</option> }
                                    </select>
                                </td>
                                <td><input class="input" type="number" min="1" @bind="it.Quantity" @bind:after="() => UpdateLine(idx)" /></td>
                                <td><input class="input" type="number" step="0.01" @bind="it.UnitPrice" @bind:after="() => UpdateLine(idx)" /></td>
                                <td><strong>@it.LineTotal.ToString("N2")</strong></td>
                                <td><button class="link danger" @onclick="() => _editing.Items.RemoveAt(idx)">حذف</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button class="ghost-btn" @onclick="AddItem">+ سطر جديد</button>

                <div style="margin-top:16px;text-align:left">
                    <p>المجموع: <strong>@_editing.Items.Sum(i => i.LineTotal).ToString("N2")</strong></p>
                    <p>الضريبة (15%): <strong>@(Math.Round(_editing.Items.Sum(i => i.LineTotal) * 0.15m, 2).ToString("N2"))</strong></p>
                    <p>الإجمالي: <strong>@(Math.Round(_editing.Items.Sum(i => i.LineTotal) * 1.15m, 2).ToString("N2"))</strong></p>
                </div>

                <div class="modal-actions">
                    <button class="ghost-btn" @onclick="() => _editing = null">إلغاء</button>
                    <button class="primary-btn" @onclick="Save">حفظ المرتجع</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<SalesReturn> _list = new();
    private List<Product> _products = new();
    private List<Customer> _customers = new();
    private SalesReturn? _editing;

    protected override async Task OnInitializedAsync()
    {
        _products = await InvSvc.GetProductsAsync();
        _customers = await CustSvc.GetAsync();
        await Refresh();
    }

    private async Task Refresh() => _list = await OpsSvc.GetReturnsAsync();

    private void StartNew()
    {
        _editing = new SalesReturn { Date = DateTime.Today, CustomerName = "زبون نقدي", RefundMethod = "نقدي" };
        _editing.Items.Add(new SalesReturnItem { Quantity = 1 });
    }

    private void AddItem() => _editing?.Items.Add(new SalesReturnItem { Quantity = 1 });

    private void OnProductChanged(int idx)
    {
        if (_editing == null) return;
        var it = _editing.Items[idx];
        var p = _products.FirstOrDefault(x => x.Id == it.ProductId);
        if (p != null) { it.ProductName = p.Name; it.UnitPrice = p.Price; }
        UpdateLine(idx);
    }

    private void UpdateLine(int idx)
    {
        if (_editing == null) return;
        var it = _editing.Items[idx];
        it.LineTotal = it.UnitPrice * it.Quantity;
    }

    private async Task Save()
    {
        if (_editing == null) return;
        if (!_editing.Items.Any(i => i.ProductId > 0 && i.Quantity > 0)) return;
        _editing.Items = _editing.Items.Where(i => i.ProductId > 0 && i.Quantity > 0).ToList();
        await OpsSvc.CreateReturnAsync(_editing);
        await Audit.LogAsync("إنشاء مرتجع مبيعات", "المبيعات", $"{_editing.CustomerName} - {_editing.Total:N2}");
        _editing = null;
        await Refresh();
    }

    private async Task Delete(int id) { await OpsSvc.DeleteReturnAsync(id); await Refresh(); }

    private int? _quickNumber;
    private string _quickError = "";
    private string _quickInfo = "";

    private async Task OnQuickKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddByNumber();
    }

    private Task AddByNumber()
    {
        _quickError = ""; _quickInfo = "";
        if (_editing == null) return Task.CompletedTask;
        if (!_quickNumber.HasValue || _quickNumber.Value <= 0)
        {
            _quickError = "أدخل رقم المنتج"; return Task.CompletedTask;
        }
        var p = _products.FirstOrDefault(x => x.DisplayNumber == _quickNumber.Value);
        if (p == null)
        {
            _quickError = $"❌ لا يوجد منتج برقم {_quickNumber}"; return Task.CompletedTask;
        }
        // Increase qty if already in list, else add new line
        var existing = _editing.Items.FirstOrDefault(i => i.ProductId == p.Id);
        if (existing != null)
        {
            existing.Quantity++;
            existing.LineTotal = existing.Quantity * existing.UnitPrice;
        }
        else
        {
            _editing.Items.Add(new SalesReturnItem { ProductId = p.Id, ProductName = p.Name, UnitPrice = p.Price, Quantity = 1, LineTotal = p.Price });
        }
        _quickInfo = $"✅ أُضيف: #{p.DisplayNumber} {p.Name}";
        _quickNumber = null;
        return Task.CompletedTask;
    }
}
