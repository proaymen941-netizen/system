@page "/reports"
@rendermode InteractiveServer
@inject DashboardService Dashboard
@inject AccountingService Accounting
@inject InventoryService Inventory
@inject HrService Hr

<PageTitle>التقارير</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">التقارير</h1>
            <p class="page-subtitle">نظرة شاملة على نشاط المؤسسة</p>
        </div>
        <div class="page-header-actions">
            <input class="input" type="date" @bind="_from" @bind:after="Refresh" />
            <input class="input" type="date" @bind="_to" @bind:after="Refresh" />
            <button class="ghost-btn" @onclick="Reset">مسح</button>
            <a class="ghost-btn" href="/trial-balance">📊 ميزان المراجعة</a>
        </div>
    </div>

    @if (_summary != null && _financials != null)
    {
        <div class="stat-grid">
            <div class="stat-card stat-green"><div class="stat-icon">💵</div><div class="stat-body"><div class="stat-label">المبيعات</div><div class="stat-value">@_summary.TotalSales.ToString("N0") <span class="stat-unit">ريال</span></div></div></div>
            <div class="stat-card stat-blue"><div class="stat-icon">🧾</div><div class="stat-body"><div class="stat-label">المشتريات</div><div class="stat-value">@_summary.TotalPurchases.ToString("N0") <span class="stat-unit">ريال</span></div></div></div>
            <div class="stat-card stat-purple"><div class="stat-icon">📈</div><div class="stat-body"><div class="stat-label">صافي الربح</div><div class="stat-value">@_financials.NetProfit.ToString("N0") <span class="stat-unit">ريال</span></div></div></div>
            <div class="stat-card stat-orange"><div class="stat-icon">📦</div><div class="stat-body"><div class="stat-label">قيمة المخزون</div><div class="stat-value">@_financials.Inventory.ToString("N0") <span class="stat-unit">ريال</span></div></div></div>
        </div>

        <div class="grid-2">
            <div class="panel">
                <div class="panel-header">
                    <h3>المبيعات الأسبوعية</h3>
                    <a class="link" href="/export/sales.xlsx" target="_blank">📊 Excel</a>
                </div>
                <div class="bar-chart">
                    @{ var max = Math.Max(1m, _summary.DailySales.Max(x => x.Amount)); }
                    @foreach (var d in _summary.DailySales)
                    {
                        var h = (int)((double)d.Amount / (double)max * 100);
                        <div class="bar-col">
                            <div class="bar-track"><div class="bar-fill" style="height:@(h)%"></div></div>
                            <div class="bar-label">@d.Day</div>
                            <div class="bar-value">@d.Amount.ToString("N0")</div>
                        </div>
                    }
                </div>
            </div>

            <div class="panel">
                <div class="panel-header">
                    <h3>تقرير المخزون</h3>
                    <a class="link" href="/export/products.xlsx" target="_blank">📊 Excel</a>
                </div>
                <table class="table-soft">
                    <thead><tr><th>الصنف</th><th>الكمية</th><th>قيمة المخزون</th></tr></thead>
                    <tbody>
                        @foreach (var p in _products.OrderByDescending(p => p.Quantity * p.Cost).Take(8))
                        {
                            <tr>
                                <td><span class="emoji">@p.ImageEmoji</span> @p.Name</td>
                                <td>@p.Quantity</td>
                                <td>@((p.Quantity * p.Cost).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <h3>تقرير الموظفين والرواتب</h3>
                <a class="link" href="/export/employees.xlsx" target="_blank">📊 Excel</a>
            </div>
            <table class="table-soft striped">
                <thead><tr><th>الموظف</th><th>القسم</th><th>الراتب</th><th>تاريخ التوظيف</th></tr></thead>
                <tbody>
                    @foreach (var e in _employees)
                    {
                        <tr>
                            <td>@e.Name</td>
                            <td>@e.Department</td>
                            <td>@e.Salary.ToString("N2")</td>
                            <td>@e.HireDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private DashboardSummary? _summary;
    private FinancialSummary? _financials;
    private List<Product> _products = new();
    private List<Employee> _employees = new();
    private DateTime? _from;
    private DateTime? _to;

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh()
    {
        _summary = await Dashboard.GetSummaryAsync();
        _financials = await Accounting.GetSummaryAsync(_from, _to);
        _products = await Inventory.GetProductsAsync();
        _employees = await Hr.GetEmployeesAsync();
    }

    private async Task Reset() { _from = null; _to = null; await Refresh(); }
}
