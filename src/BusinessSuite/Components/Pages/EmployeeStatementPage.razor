@page "/employee-statement"
@rendermode InteractiveServer
@inject HrService HrSvc
@inject HrExtendedService HrExt

<PageTitle>كشف حساب الموظف</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">كشف حساب الموظف الشامل</h1>
            <p class="page-subtitle">عرض الراتب والجزاءات والمكافآت والأقساط والغياب وصافي المستحق</p>
        </div>
    </div>

    <div class="panel">
        <div class="form-grid">
            <label>الموظف
                <select class="input" @bind="_employeeId">
                    <option value="0">— اختر —</option>
                    @foreach (var e in _employees) { <option value="@e.Id">@e.Name</option> }
                </select>
            </label>
            <label>السنة<input class="input" type="number" @bind="_year" /></label>
            <label>الشهر
                <select class="input" @bind="_month">
                    @for (int m = 1; m <= 12; m++) { <option value="@m">@m</option> }
                </select>
            </label>
            <label>&nbsp;<button class="primary-btn" @onclick="Load">عرض الكشف</button></label>
        </div>
    </div>

    @if (_summary != null)
    {
        <div class="stat-grid stat-grid-3">
            <div class="stat-card stat-blue"><div class="stat-icon">💼</div><div class="stat-body"><div class="stat-label">الراتب الأساسي</div><div class="stat-value">@_summary.Salary.ToString("N2")</div></div></div>
            <div class="stat-card stat-green"><div class="stat-icon">🎁</div><div class="stat-body"><div class="stat-label">المكافآت</div><div class="stat-value">@_summary.Rewards.ToString("N2")</div></div></div>
            <div class="stat-card stat-orange"><div class="stat-icon">⛔</div><div class="stat-body"><div class="stat-label">الجزاءات</div><div class="stat-value">@_summary.Penalties.ToString("N2")</div></div></div>
        </div>
        <div class="stat-grid stat-grid-3">
            <div class="stat-card stat-purple"><div class="stat-icon">📋</div><div class="stat-body"><div class="stat-label">أقساط</div><div class="stat-value">@_summary.Installments.ToString("N2")</div></div></div>
            <div class="stat-card stat-orange"><div class="stat-icon">📅</div><div class="stat-body"><div class="stat-label">خصم الغياب</div><div class="stat-value">@_summary.AbsenceDeductions.ToString("N2")</div></div></div>
            <div class="stat-card stat-green" style="background:#dcfce7"><div class="stat-icon">💰</div><div class="stat-body"><div class="stat-label">صافي المستحق</div><div class="stat-value"><strong>@_summary.NetPay.ToString("N2")</strong></div></div></div>
        </div>

        <div class="panel">
            <h3>تفاصيل الحساب</h3>
            <table class="table-soft striped">
                <tbody>
                    <tr><td><strong>الموظف</strong></td><td>@_summary.EmployeeName</td></tr>
                    <tr><td><strong>الفترة</strong></td><td>@_year/@_month</td></tr>
                    <tr><td><strong>الراتب الأساسي</strong></td><td>@_summary.Salary.ToString("N2")</td></tr>
                    <tr><td><strong>+ المكافآت</strong></td><td class="text-green">@_summary.Rewards.ToString("N2")</td></tr>
                    <tr><td><strong>− الجزاءات</strong></td><td class="text-orange">@_summary.Penalties.ToString("N2")</td></tr>
                    <tr><td><strong>− الأقساط</strong></td><td class="text-orange">@_summary.Installments.ToString("N2")</td></tr>
                    <tr><td><strong>− خصم الغياب</strong></td><td class="text-orange">@_summary.AbsenceDeductions.ToString("N2")</td></tr>
                    <tr style="background:#f0fdf4;font-size:1.1em"><td><strong>صافي المستحق</strong></td><td><strong>@_summary.NetPay.ToString("N2")</strong></td></tr>
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private int _employeeId;
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private List<Employee> _employees = new();
    private EmployeeMonthlySummary? _summary;

    protected override async Task OnInitializedAsync() => _employees = await HrSvc.GetEmployeesAsync();

    private async Task Load()
    {
        if (_employeeId == 0) return;
        _summary = await HrExt.GetMonthlySummaryAsync(_employeeId, _year, _month);
    }
}
