@page "/pos"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject InventoryService InvSvc
@inject PosService PosSvc
@inject CustomerService CustSvc
@inject CompanySettingsService SettingsSvc
@inject CashierShiftService ShiftSvc
@inject AuditService Audit
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>الكاشير</PageTitle>

@if (_showShiftModal)
{
    <div class="modal-overlay">
        <div class="modal" style="max-width:420px">
            <div class="modal-header">
                <h3>@(_activeShift == null ? "فتح وردية جديدة" : "إغلاق الوردية")</h3>
            </div>
            <div class="modal-body">
                @if (_activeShift == null)
                {
                    <label>رصيد الصندوق الافتتاحي (@_currency)</label>
                    <input class="input" type="number" step="0.01" @bind="_openingCash" />
                }
                else
                {
                    <div class="shift-summary">
                        <div class="shift-row"><span>الكاشير</span><strong>@_activeShift.CashierName</strong></div>
                        <div class="shift-row"><span>فُتحت</span><strong>@_activeShift.OpenedAt.ToString("hh:mm tt yyyy/MM/dd")</strong></div>
                    </div>
                    <label style="margin-top:1rem">رصيد الصندوق الختامي (@_currency)</label>
                    <input class="input" type="number" step="0.01" @bind="_closingCash" />
                    <label style="margin-top:.5rem">ملاحظات</label>
                    <textarea class="input" rows="2" @bind="_shiftNotes" placeholder="اختياري..."></textarea>
                }
            </div>
            <div class="modal-actions">
                <button class="secondary-btn" @onclick="() => _showShiftModal = false">إلغاء</button>
                <button class="primary-btn" @onclick="HandleShiftAction">
                    @(_activeShift == null ? "فتح الوردية" : "إغلاق الوردية")
                </button>
            </div>
        </div>
    </div>
}

<div class="pos-fullscreen" dir="rtl">
    <div class="pos-topbar">
        <div class="pos-topbar-left">
            <span class="pos-title">🛒 نقطة البيع</span>
            @if (_activeShift != null)
            {
                <span class="shift-badge open">📋 وردية مفتوحة — @_activeShift.CashierName</span>
            }
            else
            {
                <span class="shift-badge closed">⚠️ لا توجد وردية</span>
            }
            <span class="pos-keyboard-hint">⌨️ اضغط رقم المنتج ثم Enter للإضافة • → للطباعة • Esc لمسح الرقم • Delete لمسح الطلب</span>
        </div>
        <div class="pos-topbar-right">
            <span class="pos-time">@_now.ToString("hh:mm tt")</span>
            <span class="pos-date">@_now.ToString("yyyy/MM/dd")</span>
            @if (_activeShift != null)
            {
                <button class="shift-btn close-shift" @onclick="() => _showShiftModal = true">إغلاق الوردية</button>
            }
            else
            {
                <button class="shift-btn open-shift" @onclick="() => _showShiftModal = true">فتح وردية</button>
            }
        </div>
    </div>

    <div class="pos-body">
        <!-- في الواجهة العربية: قائمة الطلب يمين، شبكة المنتجات يسار -->
        <div class="pos-right pos-cart-side">
            <div class="pos-order-types">
                @foreach (var ot in _orderTypes)
                {
                    <button class="order-type-btn @(_orderType == ot ? "active" : "")" @onclick="() => _orderType = ot">@ot</button>
                }
            </div>

            <div class="pos-cart-header">
                <span>الطلب #@_todayOrderPreview</span>
                <span class="muted" style="font-size:.8rem">@_cart.Count صنف</span>
                @if (_cart.Any())
                {
                    <button class="clear-cart-btn" @onclick="ClearCart" title="مسح الطلب">✕ مسح</button>
                }
            </div>

            <div class="pos-cart-items">
                @if (!_cart.Any())
                {
                    <div class="pos-empty-cart">
                        <div style="font-size:2.5rem">🛍️</div>
                        <div>اختر منتجاً للبدء</div>
                        <div class="muted" style="font-size:.8rem;margin-top:8px">اكتب رقم المنتج بالكيبورد ثم Enter</div>
                    </div>
                }
                @{ int rowIdx = 0; }
                @foreach (var item in _cart)
                {
                    var isSel = rowIdx == _selectedRow;
                    <div class="pos-cart-row @(isSel ? "selected-row" : "")" @onclick="() => SelectRow(item)">
                        <div class="pcr-info">
                            <div class="pcr-name">
                                @if (item.DisplayNumber > 0) { <span class="pcr-num">#@item.DisplayNumber</span> }
                                @item.ProductName
                            </div>
                            <div class="pcr-unit">@item.UnitPrice.ToString("N0") @_currency</div>
                        </div>
                        <div class="pcr-qty" @onclick:stopPropagation="true">
                            <button @onclick="() => ChangeQty(item, -1)">−</button>
                            <span>@item.Quantity</span>
                            <button @onclick="() => ChangeQty(item, +1)">+</button>
                        </div>
                        <div class="pcr-total">@item.LineTotal.ToString("N0")</div>
                    </div>
                    rowIdx++;
                }
            </div>

            <div class="pos-totals">
                <div class="pt-row"><span>المجموع</span><span>@Subtotal.ToString("N2") @_currency</span></div>
                <div class="pt-row"><span>الضريبة @_taxRate%</span><span>@Tax.ToString("N2") @_currency</span></div>
                <div class="pt-row grand"><span>الإجمالي</span><span>@Total.ToString("N2") @_currency</span></div>
            </div>

            <div class="pos-payment-btns">
                @foreach (var pm in new[] { "نقدي", "بطاقة", "محفظة" })
                {
                    <button class="pm-btn @(_payment == pm ? "active-pm" : "")" @onclick="() => _payment = pm">@pm</button>
                }
                <button class="pm-btn pm-deferred @(_paymentStatus == InvoicePaymentStatus.Unpaid ? "active-pm" : "")"
                        @onclick='() => _paymentStatus = _paymentStatus == InvoicePaymentStatus.Unpaid ? InvoicePaymentStatus.Paid : InvoicePaymentStatus.Unpaid'>
                    آجل
                </button>
            </div>

            <div style="padding:0 0.75rem">
                <label class="muted" style="font-size:.8rem">العميل</label>
                <select class="input" @bind="_customerId" style="margin-top:2px">
                    @foreach (var c in _customers) { <option value="@c.Id">@c.Name</option> }
                </select>
            </div>

            @if (!string.IsNullOrEmpty(_error)) { <div class="error-banner" style="margin:.5rem .75rem">@_error</div> }

            <button class="pos-checkout-btn" @onclick="Checkout" disabled="@(!_cart.Any())">
                ✅ إتمام البيع — @Total.ToString("N2") @_currency
            </button>

            @if (!string.IsNullOrEmpty(_lastInvoice))
            {
                <div class="pos-success-row">
                    <span>✅ فاتورة @_lastInvoice</span>
                    <div style="display:flex;gap:.5rem">
                        <a href="/print/sale/@_lastInvoiceId" target="_blank" class="print-btn">🖨️ إيصال العميل</a>
                        <a href="/print/kitchen/@_lastInvoiceId" target="_blank" class="print-btn kitchen">📋 قصاصة المطبخ</a>
                    </div>
                </div>
            }
        </div>

        <div class="pos-left">
            <div class="pos-search-bar">
                <div class="pos-num-buffer @(string.IsNullOrEmpty(_numBuffer) ? "" : "active")" title="رقم المنتج">
                    <span class="nb-label">رقم المنتج</span>
                    <span class="nb-value">@(string.IsNullOrEmpty(_numBuffer) ? "—" : _numBuffer)</span>
                    @if (!string.IsNullOrEmpty(_numBuffer))
                    {
                        <button class="nb-clear" @onclick="ClearNumBuffer" title="مسح">✕</button>
                    }
                </div>
                <input class="pos-search-input" placeholder="🔍 بحث عن منتج..." @bind="_search" @bind:event="oninput" />
                <input class="pos-barcode-input" id="barcode-input" placeholder="📱 باركود..." @bind="_barcode" @bind:event="oninput" @onkeyup="OnBarcodeKey" />
            </div>

            <div class="pos-categories">
                <button class="cat-btn @(_category == "" ? "active" : "")" @onclick='() => _category = ""'>الكل</button>
                @foreach (var cat in _categories)
                {
                    <button class="cat-btn @(_category == cat ? "active" : "")" @onclick="() => _category = cat">@cat</button>
                }
            </div>

            <div class="pos-product-grid">
                @foreach (var p in FilteredProducts)
                {
                    <button class="pos-product-btn @(p.Quantity <= 0 ? "out-of-stock" : "")"
                            @onclick="() => AddItem(p)"
                            disabled="@(p.Quantity <= 0)">
                        @if (p.DisplayNumber > 0)
                        {
                            <div class="ppb-num-badge">@p.DisplayNumber</div>
                        }
                        <div class="ppb-emoji">@p.ImageEmoji</div>
                        <div class="ppb-name">@p.Name</div>
                        <div class="ppb-price">@p.Price.ToString("N0") @_currency</div>
                        @if (!string.IsNullOrEmpty(p.Sku))
                        {
                            <div class="ppb-code">@p.Sku</div>
                        }
                        @if (p.Quantity <= 0) { <div class="ppb-out">نفذ</div> }
                    </button>
                }
                @if (!FilteredProducts.Any())
                {
                    <div class="pos-empty-products">
                        <div style="font-size:2.5rem">📭</div>
                        <div>لا توجد منتجات تطابق البحث</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<Product> _products = new();
    private List<Customer> _customers = new();
    private List<SaleInvoiceItem> _cart = new();
    private string _search = string.Empty;
    private string _barcode = string.Empty;
    private string _payment = "نقدي";
    private InvoicePaymentStatus _paymentStatus = InvoicePaymentStatus.Paid;
    private string _lastInvoice = string.Empty;
    private int _lastInvoiceId;
    private int _customerId;
    private string _currency = "ر.س";
    private decimal _taxRate = 15m;
    private string _error = "";
    private string _category = "";
    private List<string> _categories = new();
    private string _orderType = "محلي";
    private List<string> _orderTypes = new() { "محلي", "آمر صرف", "توصيل" };
    private CashierShift? _activeShift;
    private bool _showShiftModal;
    private decimal _openingCash;
    private decimal _closingCash;
    private string _shiftNotes = "";
    private int _todayOrderPreview = 1;
    private DateTime _now = DateTime.Now;
    private System.Threading.Timer? _timer;

    private string _numBuffer = "";
    private int _selectedRow = -1;
    private DotNetObjectReference<Pos>? _selfRef;

    protected override async Task OnInitializedAsync()
    {
        var s = await SettingsSvc.GetAsync();
        _currency = s.Currency;
        _taxRate = s.TaxRate;
        if (!string.IsNullOrWhiteSpace(s.OrderTypeLocal)) _orderTypes[0] = s.OrderTypeLocal;
        if (!string.IsNullOrWhiteSpace(s.OrderTypeTakeaway)) _orderTypes[1] = s.OrderTypeTakeaway;
        if (!string.IsNullOrWhiteSpace(s.OrderTypeDelivery)) _orderTypes[2] = s.OrderTypeDelivery;
        _orderType = _orderTypes[0];

        _customers = await CustSvc.GetAsync();
        _customerId = _customers.FirstOrDefault()?.Id ?? 0;
        _activeShift = await ShiftSvc.GetActiveShiftAsync();
        await Refresh();
        await UpdateOrderPreview();

        _timer = new System.Threading.Timer(_ => InvokeAsync(() => { _now = DateTime.Now; StateHasChanged(); }), null, 0, 1000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            try { await Js.InvokeVoidAsync("posKeyboard.attach", _selfRef); } catch { }
        }
    }

    private async Task Refresh()
    {
        _products = await InvSvc.GetProductsAsync();
        // Auto-assign display numbers to products that don't have one yet, so cashier can use the keyboard right away
        var needs = _products.Where(p => p.DisplayNumber <= 0).ToList();
        if (needs.Any())
        {
            var max = _products.Max(p => p.DisplayNumber);
            foreach (var p in needs)
            {
                p.DisplayNumber = ++max;
                try { await InvSvc.SaveProductAsync(p); } catch { /* ignore — non-admin */ }
            }
            _products = await InvSvc.GetProductsAsync();
        }
        _categories = _products.Select(p => p.Category).Distinct().Where(c => !string.IsNullOrEmpty(c)).OrderBy(c => c).ToList();
    }

    private async Task UpdateOrderPreview()
    {
        var invoices = await PosSvc.GetRecentSalesAsync(1000, DateTime.Today, null);
        _todayOrderPreview = invoices.Count + 1;
    }

    private IEnumerable<Product> FilteredProducts =>
        _products.Where(p =>
            (string.IsNullOrWhiteSpace(_category) || p.Category == _category) &&
            (string.IsNullOrWhiteSpace(_search) || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || p.Sku.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(p => p.DisplayNumber == 0 ? int.MaxValue : p.DisplayNumber)
        .ThenBy(p => p.Name);

    private async Task OnBarcodeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_barcode))
        {
            var p = await InvSvc.GetByBarcodeAsync(_barcode.Trim());
            if (p != null) AddItem(p);
            else _error = $"❌ لم يتم العثور على منتج بـ SKU: {_barcode}";
            _barcode = "";
        }
    }

    private void AddItem(Product p)
    {
        _error = "";
        var existing = _cart.FirstOrDefault(c => c.ProductId == p.Id);
        if (existing != null) { existing.Quantity++; existing.LineTotal = existing.Quantity * existing.UnitPrice; }
        else _cart.Add(new SaleInvoiceItem
        {
            ProductId = p.Id,
            ProductName = p.Name,
            DisplayNumber = p.DisplayNumber,
            UnitPrice = p.Price,
            Quantity = 1,
            LineTotal = p.Price
        });
        _selectedRow = _cart.Count - 1;
    }

    private void ChangeQty(SaleInvoiceItem item, int delta)
    {
        item.Quantity += delta;
        if (item.Quantity <= 0) _cart.Remove(item);
        else item.LineTotal = item.Quantity * item.UnitPrice;
        if (_selectedRow >= _cart.Count) _selectedRow = _cart.Count - 1;
    }

    private void SelectRow(SaleInvoiceItem item)
    {
        var idx = _cart.IndexOf(item);
        if (idx < 0) return;
        if (_selectedRow == idx)
        {
            // tap on already-selected row = +1
            ChangeQty(item, +1);
        }
        else
        {
            _selectedRow = idx;
        }
    }

    private void ClearCart()
    {
        _cart.Clear();
        _error = "";
        _lastInvoice = "";
        _selectedRow = -1;
    }

    private void ClearNumBuffer() { _numBuffer = ""; }

    // ============ JS-invokable keyboard handlers ============
    [JSInvokable]
    public Task OnDigit(string d)
    {
        if (_numBuffer.Length < 8) _numBuffer += d;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnEnter()
    {
        if (string.IsNullOrEmpty(_numBuffer))
        {
            // No buffer: Enter checks out
            if (_cart.Any()) await Checkout();
            return;
        }
        if (int.TryParse(_numBuffer, out var num))
        {
            var p = _products.FirstOrDefault(x => x.DisplayNumber == num);
            if (p != null) AddItem(p);
            else _error = $"❌ لا يوجد منتج برقم {num}";
        }
        _numBuffer = "";
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnBackspace()
    {
        if (_numBuffer.Length > 0) _numBuffer = _numBuffer.Substring(0, _numBuffer.Length - 1);
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnEscape()
    {
        _numBuffer = "";
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnArrow(string direction)
    {
        switch (direction)
        {
            case "right": // → confirm/print
                if (_cart.Any()) await Checkout();
                break;
            case "left": // ← cancel current row
                if (_selectedRow >= 0 && _selectedRow < _cart.Count)
                {
                    _cart.RemoveAt(_selectedRow);
                    if (_selectedRow >= _cart.Count) _selectedRow = _cart.Count - 1;
                    StateHasChanged();
                }
                break;
            case "up":
                if (_cart.Any()) { _selectedRow = Math.Max(0, _selectedRow - 1); StateHasChanged(); }
                break;
            case "down":
                if (_cart.Any()) { _selectedRow = Math.Min(_cart.Count - 1, _selectedRow + 1); StateHasChanged(); }
                break;
        }
    }

    [JSInvokable]
    public Task OnDelete()
    {
        ClearCart();
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnPlus()
    {
        if (_selectedRow >= 0 && _selectedRow < _cart.Count) ChangeQty(_cart[_selectedRow], +1);
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnMinus()
    {
        if (_selectedRow >= 0 && _selectedRow < _cart.Count) ChangeQty(_cart[_selectedRow], -1);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private decimal Subtotal => _cart.Sum(i => i.LineTotal);
    private decimal Tax => Math.Round(Subtotal * (_taxRate / 100m), 2);
    private decimal Total => Subtotal + Tax;

    private async Task Checkout()
    {
        if (!_cart.Any()) return;
        _error = "";
        var customer = _customers.FirstOrDefault(c => c.Id == _customerId);
        var inv = new SaleInvoice
        {
            PaymentMethod = _payment,
            CustomerName = customer?.Name ?? "زبون نقدي",
            CustomerId = customer?.Id,
            PaymentStatus = _paymentStatus,
            OrderType = _orderType,
            ShiftId = _activeShift?.Id,
            Items = _cart.Select(c => new SaleInvoiceItem
            {
                ProductId = c.ProductId,
                ProductName = c.ProductName,
                DisplayNumber = c.DisplayNumber,
                Quantity = c.Quantity,
                UnitPrice = c.UnitPrice,
                LineTotal = c.LineTotal,
            }).ToList(),
        };
        try
        {
            await PosSvc.CompleteSaleAsync(inv);
            _lastInvoice = inv.InvoiceNumber;
            _lastInvoiceId = inv.Id;
            await Audit.LogAsync("بيع", "نقطة البيع", $"فاتورة {inv.InvoiceNumber} بقيمة {inv.Total:N2} — {_orderType}");
            _cart.Clear();
            _selectedRow = -1;
            _paymentStatus = InvoicePaymentStatus.Paid;
            await Refresh();
            await UpdateOrderPreview();
            await Js.InvokeVoidAsync("eval", $"window.open('/print/sale/{inv.Id}','_blank')");
        }
        catch (AuthorizationException ex) { _error = ex.Message; }
    }

    private async Task HandleShiftAction()
    {
        if (_activeShift == null)
        {
            _activeShift = await ShiftSvc.OpenShiftAsync(_openingCash);
            _openingCash = 0;
        }
        else
        {
            await ShiftSvc.CloseShiftAsync(_activeShift.Id, _closingCash, _shiftNotes);
            _activeShift = null;
            _closingCash = 0;
            _shiftNotes = "";
        }
        _showShiftModal = false;
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        try { await Js.InvokeVoidAsync("posKeyboard.detach"); } catch { }
        _selfRef?.Dispose();
    }
}
