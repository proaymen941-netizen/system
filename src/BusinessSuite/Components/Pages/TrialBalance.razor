@page "/trial-balance"
@rendermode InteractiveServer
@inject AccountingService Acct

<PageTitle>ميزان المراجعة</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">ميزان المراجعة</h1>
            <p class="page-subtitle">إجمالي الإيرادات والمصروفات حسب الفئة</p>
        </div>
        <div class="page-header-actions">
            <input class="input" type="date" @bind="_from" @bind:after="Refresh" placeholder="من" />
            <input class="input" type="date" @bind="_to" @bind:after="Refresh" placeholder="إلى" />
            <button class="ghost-btn" @onclick="Reset">مسح</button>
            <a class="ghost-btn" href="@ExportUrl("csv")" target="_blank">⬇️ CSV</a>
            <a class="ghost-btn" href="@ExportUrl("xlsx")" target="_blank">📊 Excel</a>
        </div>
    </div>

    @if (_summary != null)
    {
        <div class="stat-grid">
            <div class="stat-card stat-green"><div class="stat-icon">💵</div><div class="stat-body"><div class="stat-label">الإيرادات</div><div class="stat-value">@_summary.Income.ToString("N2")</div></div></div>
            <div class="stat-card stat-orange"><div class="stat-icon">💸</div><div class="stat-body"><div class="stat-label">المصروفات</div><div class="stat-value">@_summary.Expense.ToString("N2")</div></div></div>
            <div class="stat-card stat-purple"><div class="stat-icon">📊</div><div class="stat-body"><div class="stat-label">الفرق (الربح)</div><div class="stat-value">@_summary.NetProfit.ToString("N2")</div></div></div>
            <div class="stat-card stat-blue"><div class="stat-icon">📦</div><div class="stat-body"><div class="stat-label">قيمة المخزون</div><div class="stat-value">@_summary.Inventory.ToString("N2")</div></div></div>
        </div>
    }

    <div class="grid-2">
        <div class="panel">
            <div class="panel-header"><h3>📈 الإيرادات</h3></div>
            <table class="table-soft striped">
                <thead><tr><th>الفئة</th><th>عدد القيود</th><th>الإجمالي</th></tr></thead>
                <tbody>
                    @foreach (var r in _rows.Where(r => r.Type == EntryType.Income))
                    {
                        <tr>
                            <td>@r.Category</td>
                            <td>@r.Count</td>
                            <td><strong class="text-green">@r.Total.ToString("N2")</strong></td>
                        </tr>
                    }
                    @if (!_rows.Any(r => r.Type == EntryType.Income))
                    {
                        <tr><td colspan="3" class="empty">لا يوجد</td></tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th colspan="2">الإجمالي</th><th class="text-green">@_rows.Where(r => r.Type == EntryType.Income).Sum(r => r.Total).ToString("N2")</th></tr>
                </tfoot>
            </table>
        </div>

        <div class="panel">
            <div class="panel-header"><h3>📉 المصروفات</h3></div>
            <table class="table-soft striped">
                <thead><tr><th>الفئة</th><th>عدد القيود</th><th>الإجمالي</th></tr></thead>
                <tbody>
                    @foreach (var r in _rows.Where(r => r.Type == EntryType.Expense))
                    {
                        <tr>
                            <td>@r.Category</td>
                            <td>@r.Count</td>
                            <td><strong class="text-red">@r.Total.ToString("N2")</strong></td>
                        </tr>
                    }
                    @if (!_rows.Any(r => r.Type == EntryType.Expense))
                    {
                        <tr><td colspan="3" class="empty">لا يوجد</td></tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th colspan="2">الإجمالي</th><th class="text-red">@_rows.Where(r => r.Type == EntryType.Expense).Sum(r => r.Total).ToString("N2")</th></tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@code {
    private List<TrialBalanceRow> _rows = new();
    private FinancialSummary? _summary;
    private DateTime? _from;
    private DateTime? _to;

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh()
    {
        _rows = await Acct.GetTrialBalanceAsync(_from, _to);
        _summary = await Acct.GetSummaryAsync(_from, _to);
    }

    private async Task Reset() { _from = null; _to = null; await Refresh(); }

    private string ExportUrl(string format)
    {
        var qs = new List<string>();
        if (_from.HasValue) qs.Add($"from={_from:yyyy-MM-dd}");
        if (_to.HasValue) qs.Add($"to={_to:yyyy-MM-dd}");
        return $"/export/trial-balance.{format}" + (qs.Any() ? "?" + string.Join("&", qs) : "");
    }
}
