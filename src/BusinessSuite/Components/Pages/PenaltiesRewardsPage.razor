@page "/penalties-rewards"
@rendermode InteractiveServer
@inject HrExtendedService HrExt
@inject HrService HrSvc
@inject AuthService Auth
@inject AuditService Audit

<PageTitle>الجزاءات والمكافآت</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">الجزاءات والمكافآت الثابتة</h1>
            <p class="page-subtitle">تسجيل جزاءات ومكافآت الموظفين الثابتة والمتغيرة</p>
        </div>
        <div class="page-header-actions">
            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant))
            {
                <button class="primary-btn" @onclick="StartNew">+ تسجيل جديد</button>
            }
        </div>
    </div>

    <div class="stat-grid stat-grid-3">
        <div class="stat-card stat-orange"><div class="stat-icon">⛔</div><div class="stat-body"><div class="stat-label">إجمالي الجزاءات</div><div class="stat-value">@_list.Where(p => p.Kind == PenaltyKind.Penalty).Sum(p => p.Amount).ToString("N2")</div></div></div>
        <div class="stat-card stat-green"><div class="stat-icon">🎁</div><div class="stat-body"><div class="stat-label">إجمالي المكافآت</div><div class="stat-value">@_list.Where(p => p.Kind == PenaltyKind.Reward).Sum(p => p.Amount).ToString("N2")</div></div></div>
        <div class="stat-card stat-blue"><div class="stat-icon">📋</div><div class="stat-body"><div class="stat-label">سجلات</div><div class="stat-value">@_list.Count</div></div></div>
    </div>

    <div class="panel">
        <table class="table-soft striped">
            <thead><tr><th>التاريخ</th><th>الموظف</th><th>النوع</th><th>المبلغ</th><th>السبب</th><th>متكرر</th><th></th></tr></thead>
            <tbody>
                @if (!_list.Any()) { <tr><td colspan="7" class="empty">لا توجد سجلات</td></tr> }
                @foreach (var p in _list)
                {
                    <tr>
                        <td>@p.Date.ToString("yyyy-MM-dd")</td>
                        <td>@(p.Employee?.Name ?? "-")</td>
                        <td><span class="@(p.Kind == PenaltyKind.Penalty ? "text-orange" : "text-green")">@(p.Kind == PenaltyKind.Penalty ? "جزاء" : "مكافأة")</span></td>
                        <td><strong>@p.Amount.ToString("N2")</strong></td>
                        <td>@p.Reason</td>
                        <td>@(p.IsRecurring ? "✓ شهري" : "—")</td>
                        <td>
                            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant))
                            {
                                <button class="link danger" @onclick="() => Delete(p.Id)">حذف</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_editing != null)
    {
        <div class="modal-overlay" @onclick="() => _editing = null">
            <div class="modal" @onclick:stopPropagation="true">
                <h3>تسجيل جزاء/مكافأة</h3>
                <EditForm Model="_editing" OnValidSubmit="Save">
                    <div class="form-grid">
                        <label>الموظف
                            <select class="input" @bind="_editing.EmployeeId" required>
                                <option value="0">— اختر —</option>
                                @foreach (var e in _employees) { <option value="@e.Id">@e.Name</option> }
                            </select>
                        </label>
                        <label>النوع
                            <select class="input" @bind="_editing.Kind">
                                <option value="@PenaltyKind.Penalty">جزاء (خصم)</option>
                                <option value="@PenaltyKind.Reward">مكافأة (إضافة)</option>
                            </select>
                        </label>
                        <label>التاريخ<input class="input" type="date" @bind="_editing.Date" /></label>
                        <label>المبلغ<input class="input" type="number" step="0.01" @bind="_editing.Amount" required /></label>
                        <label class="full"><input type="checkbox" @bind="_editing.IsRecurring" /> متكرر شهرياً (يطبق كل شهر تلقائياً)</label>
                        <label class="full">السبب<textarea class="input" rows="2" @bind="_editing.Reason"></textarea></label>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="ghost-btn" @onclick="() => _editing = null">إلغاء</button>
                        <button type="submit" class="primary-btn">حفظ</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private List<EmployeePenaltyReward> _list = new();
    private List<Employee> _employees = new();
    private EmployeePenaltyReward? _editing;

    protected override async Task OnInitializedAsync()
    {
        _employees = await HrSvc.GetEmployeesAsync();
        await Refresh();
    }

    private async Task Refresh() => _list = await HrExt.GetPenaltiesAsync();

    private void StartNew() => _editing = new EmployeePenaltyReward { Date = DateTime.Today, Kind = PenaltyKind.Penalty };

    private async Task Save()
    {
        if (_editing == null) return;
        await HrExt.SavePenaltyAsync(_editing);
        await Audit.LogAsync(_editing.Kind == PenaltyKind.Penalty ? "تسجيل جزاء" : "تسجيل مكافأة", "الموارد البشرية", $"موظف #{_editing.EmployeeId} - {_editing.Amount:N2}");
        _editing = null;
        await Refresh();
    }

    private async Task Delete(int id) { await HrExt.DeletePenaltyAsync(id); await Refresh(); }
}
