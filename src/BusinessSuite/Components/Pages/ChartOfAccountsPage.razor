@page "/chart-of-accounts"
@rendermode InteractiveServer
@inject AccountingExtendedService AccSvc
@inject AuthService Auth

<PageTitle>شجرة الحسابات</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">شجرة الحسابات</h1>
            <p class="page-subtitle">دليل الحسابات المحاسبية للنظام</p>
        </div>
        <div class="page-header-actions">
            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant))
            {
                <button class="primary-btn" @onclick="() => _editing = new ChartOfAccount { Kind = AccountKind.Asset }">+ حساب جديد</button>
            }
        </div>
    </div>

    <div class="panel">
        <table class="table-soft striped">
            <thead><tr><th>الكود</th><th>الاسم</th><th>النوع</th><th>الرصيد الافتتاحي</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
                @if (!_accounts.Any()) { <tr><td colspan="6" class="empty">لا توجد حسابات</td></tr> }
                @foreach (var a in _accounts)
                {
                    <tr>
                        <td dir="ltr"><strong>@a.Code</strong></td>
                        <td>@a.Name</td>
                        <td>@KindAr(a.Kind)</td>
                        <td>@a.OpeningBalance.ToString("N2")</td>
                        <td>@(a.IsActive ? "نشط" : "متوقف")</td>
                        <td>
                            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant))
                            {
                                <button class="link" @onclick="() => Edit(a)">تعديل</button>
                                <button class="link danger" @onclick="() => Delete(a.Id)">حذف</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_editing != null)
    {
        <div class="modal-overlay" @onclick="() => _editing = null">
            <div class="modal" @onclick:stopPropagation="true">
                <h3>@(_editing.Id == 0 ? "إضافة حساب" : "تعديل حساب")</h3>
                <EditForm Model="_editing" OnValidSubmit="Save">
                    <div class="form-grid">
                        <label>الكود<input class="input" @bind="_editing.Code" required /></label>
                        <label>الاسم<input class="input" @bind="_editing.Name" required /></label>
                        <label>النوع
                            <select class="input" @bind="_editing.Kind">
                                <option value="@AccountKind.Asset">أصول</option>
                                <option value="@AccountKind.Liability">التزامات</option>
                                <option value="@AccountKind.Equity">حقوق ملكية</option>
                                <option value="@AccountKind.Revenue">إيرادات</option>
                                <option value="@AccountKind.Expense">مصروفات</option>
                            </select>
                        </label>
                        <label>الرصيد الافتتاحي<input class="input" type="number" step="0.01" @bind="_editing.OpeningBalance" /></label>
                        <label class="full"><input type="checkbox" @bind="_editing.IsActive" /> نشط</label>
                        <label class="full">ملاحظات<input class="input" @bind="_editing.Notes" /></label>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="ghost-btn" @onclick="() => _editing = null">إلغاء</button>
                        <button type="submit" class="primary-btn">حفظ</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private List<ChartOfAccount> _accounts = new();
    private ChartOfAccount? _editing;

    protected override async Task OnInitializedAsync() => await Refresh();
    private async Task Refresh() => _accounts = await AccSvc.GetAccountsAsync();
    private void Edit(ChartOfAccount a) => _editing = new ChartOfAccount { Id = a.Id, Code = a.Code, Name = a.Name, Kind = a.Kind, ParentId = a.ParentId, IsActive = a.IsActive, Notes = a.Notes, OpeningBalance = a.OpeningBalance };

    private async Task Save()
    {
        if (_editing == null) return;
        await AccSvc.SaveAccountAsync(_editing);
        _editing = null;
        await Refresh();
    }

    private async Task Delete(int id)
    {
        await AccSvc.DeleteAccountAsync(id);
        await Refresh();
    }

    private static string KindAr(AccountKind k) => k switch
    {
        AccountKind.Asset => "أصول",
        AccountKind.Liability => "التزامات",
        AccountKind.Equity => "حقوق ملكية",
        AccountKind.Revenue => "إيرادات",
        AccountKind.Expense => "مصروفات",
        _ => k.ToString()
    };
}
