@page "/custodies"
@rendermode InteractiveServer
@inject AccountingExtendedService AccSvc
@inject HrService HrSvc
@inject AuthService Auth
@inject AuditService Audit

<PageTitle>العهد والأرصدة</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">العهد والأرصدة المدينة والدائنة</h1>
            <p class="page-subtitle">إدارة عهد الموظفين وتسوياتها</p>
        </div>
        <div class="page-header-actions">
            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant))
            {
                <button class="primary-btn" @onclick="StartNew">+ عهدة جديدة</button>
            }
        </div>
    </div>

    <div class="stat-grid stat-grid-3">
        <div class="stat-card stat-blue"><div class="stat-icon">💼</div><div class="stat-body"><div class="stat-label">إجمالي العهد</div><div class="stat-value">@_list.Count</div></div></div>
        <div class="stat-card stat-orange"><div class="stat-icon">⏳</div><div class="stat-body"><div class="stat-label">عهد غير مسواة</div><div class="stat-value">@_list.Count(c => !c.IsSettled)</div></div></div>
        <div class="stat-card stat-green"><div class="stat-icon">💵</div><div class="stat-body"><div class="stat-label">قيمة العهد القائمة</div><div class="stat-value">@_list.Where(c => !c.IsSettled && c.IsDebit).Sum(c => c.Amount).ToString("N2")</div></div></div>
    </div>

    <div class="panel">
        <table class="table-soft striped">
            <thead><tr><th>التاريخ</th><th>الموظف</th><th>النوع</th><th>المبلغ</th><th>الوصف</th><th>المرجع</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
                @if (!_list.Any()) { <tr><td colspan="8" class="empty">لا توجد عهد</td></tr> }
                @foreach (var c in _list)
                {
                    <tr>
                        <td>@c.Date.ToString("yyyy-MM-dd")</td>
                        <td>@(c.Employee?.Name ?? "-")</td>
                        <td>@(c.IsDebit ? "صرف عهدة" : "تسوية")</td>
                        <td><strong>@c.Amount.ToString("N2")</strong></td>
                        <td>@c.Description</td>
                        <td>@c.Reference</td>
                        <td>@(c.IsSettled ? "مسواة" : "قائمة")</td>
                        <td>
                            @if (!c.IsSettled && Auth.HasRole(UserRole.Admin, UserRole.Accountant))
                            {
                                <button class="link" @onclick="() => Settle(c.Id)">تسوية</button>
                                <button class="link danger" @onclick="() => Delete(c.Id)">حذف</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_editing != null)
    {
        <div class="modal-overlay" @onclick="() => _editing = null">
            <div class="modal" @onclick:stopPropagation="true">
                <h3>عهدة جديدة</h3>
                <EditForm Model="_editing" OnValidSubmit="Save">
                    <div class="form-grid">
                        <label>الموظف
                            <select class="input" @bind="_editing.EmployeeId" required>
                                <option value="0">— اختر —</option>
                                @foreach (var e in _employees) { <option value="@e.Id">@e.Name</option> }
                            </select>
                        </label>
                        <label>التاريخ<input class="input" type="date" @bind="_editing.Date" /></label>
                        <label>المبلغ<input class="input" type="number" step="0.01" @bind="_editing.Amount" required /></label>
                        <label>النوع
                            <select class="input" @bind="_editing.IsDebit">
                                <option value="true">صرف عهدة (مدين)</option>
                                <option value="false">تسوية (دائن)</option>
                            </select>
                        </label>
                        <label>المرجع<input class="input" @bind="_editing.Reference" /></label>
                        <label class="full">الوصف<textarea class="input" rows="2" @bind="_editing.Description"></textarea></label>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="ghost-btn" @onclick="() => _editing = null">إلغاء</button>
                        <button type="submit" class="primary-btn">حفظ</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private List<EmployeeCustody> _list = new();
    private List<Employee> _employees = new();
    private EmployeeCustody? _editing;

    protected override async Task OnInitializedAsync()
    {
        _employees = await HrSvc.GetEmployeesAsync();
        await Refresh();
    }

    private async Task Refresh() => _list = await AccSvc.GetCustodiesAsync();

    private void StartNew() => _editing = new EmployeeCustody { Date = DateTime.Today, IsDebit = true };

    private async Task Save()
    {
        if (_editing == null) return;
        await AccSvc.SaveCustodyAsync(_editing);
        await Audit.LogAsync("حفظ عهدة", "المحاسبة", $"موظف #{_editing.EmployeeId} - {_editing.Amount:N2}");
        _editing = null;
        await Refresh();
    }

    private async Task Settle(int id)
    {
        await AccSvc.SettleCustodyAsync(id);
        await Audit.LogAsync("تسوية عهدة", "المحاسبة", $"ID={id}");
        await Refresh();
    }

    private async Task Delete(int id) { await AccSvc.DeleteCustodyAsync(id); await Refresh(); }
}
