@page "/attendance"
@rendermode InteractiveServer
@inject HrService HrSvc
@inject AuthService Auth
@inject AuditService Audit

<PageTitle>الحضور والانصراف</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">الحضور والانصراف</h1>
            <p class="page-subtitle">تسجيل حضور الموظفين اليومي</p>
        </div>
        <div class="page-header-actions">
            <input class="input" type="date" @bind="_date" @bind:after="Refresh" />
            <a class="ghost-btn" href="/leaves">📋 طلبات الإجازة</a>
        </div>
    </div>

    <div class="stat-grid stat-grid-3">
        <div class="stat-card stat-green"><div class="stat-icon">✅</div><div class="stat-body"><div class="stat-label">حاضرون</div><div class="stat-value">@_attendance.Count(a => a.Status == "حاضر")</div></div></div>
        <div class="stat-card stat-orange"><div class="stat-icon">⏰</div><div class="stat-body"><div class="stat-label">متأخرون</div><div class="stat-value">@_attendance.Count(a => a.Status == "متأخر")</div></div></div>
        <div class="stat-card stat-red"><div class="stat-icon">❌</div><div class="stat-body"><div class="stat-label">غائبون</div><div class="stat-value">@(_employees.Count - _attendance.Count(a => a.Status == "حاضر" || a.Status == "متأخر"))</div></div></div>
    </div>

    @if (!string.IsNullOrEmpty(_error)) { <div class="error-banner">@_error</div> }

    <div class="panel">
        <div class="panel-header"><h3>سجل @_date.ToString("yyyy-MM-dd")</h3></div>
        <table class="table-soft striped">
            <thead><tr><th>الموظف</th><th>القسم</th><th>الحضور</th><th>الانصراف</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
                @foreach (var emp in _employees)
                {
                    var rec = _attendance.FirstOrDefault(a => a.EmployeeId == emp.Id);
                    <tr>
                        <td><div class="cell-avatar"><div class="avatar small">@emp.Name.FirstOrDefault()</div>@emp.Name</div></td>
                        <td>@emp.Department</td>
                        <td>@(rec?.CheckIn?.ToString(@"hh\:mm") ?? "—")</td>
                        <td>@(rec?.CheckOut?.ToString(@"hh\:mm") ?? "—")</td>
                        <td>
                            @{ var status = rec?.Status ?? "غائب"; }
                            @if (status == "حاضر") { <span class="tag tag-success">حاضر</span> }
                            else if (status == "متأخر") { <span class="tag tag-warning">متأخر</span> }
                            else if (status == "إجازة") { <span class="tag tag-info">إجازة</span> }
                            else { <span class="tag tag-danger">غائب</span> }
                        </td>
                        <td>
                            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant) && _date.Date == DateTime.Today)
                            {
                                @if (rec?.CheckIn == null)
                                {
                                    <button class="link" @onclick="() => CheckIn(emp.Id)">تسجيل دخول</button>
                                }
                                else if (rec.CheckOut == null)
                                {
                                    <button class="link" @onclick="() => CheckOut(emp.Id)">تسجيل خروج</button>
                                }
                                <select class="input small inline" @bind="_statusEdit" @bind:after="() => SetStatus(emp.Id)">
                                    <option value="">— تغيير —</option>
                                    <option value="حاضر">حاضر</option>
                                    <option value="متأخر">متأخر</option>
                                    <option value="غائب">غائب</option>
                                    <option value="إجازة">إجازة</option>
                                </select>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Employee> _employees = new();
    private List<Attendance> _attendance = new();
    private DateTime _date = DateTime.Today;
    private string _statusEdit = "";
    private string _error = "";

    protected override async Task OnInitializedAsync()
    {
        _employees = await HrSvc.GetEmployeesAsync();
        await Refresh();
    }

    private async Task Refresh() => _attendance = await HrSvc.GetAttendanceAsync(_date);

    private async Task CheckIn(int empId)
    {
        try
        {
            await HrSvc.CheckInAsync(empId);
            await Audit.LogAsync("تسجيل حضور", "الموظفين", $"EmpId={empId}");
            await Refresh();
        }
        catch (AuthorizationException ex) { _error = ex.Message; }
    }

    private async Task CheckOut(int empId)
    {
        try
        {
            await HrSvc.CheckOutAsync(empId);
            await Audit.LogAsync("تسجيل انصراف", "الموظفين", $"EmpId={empId}");
            await Refresh();
        }
        catch (AuthorizationException ex) { _error = ex.Message; }
    }

    private async Task SetStatus(int empId)
    {
        if (string.IsNullOrEmpty(_statusEdit)) return;
        try
        {
            await HrSvc.SetAttendanceStatusAsync(empId, _date, _statusEdit);
            await Audit.LogAsync("تعديل حضور", "الموظفين", $"EmpId={empId} -> {_statusEdit}");
            _statusEdit = "";
            await Refresh();
        }
        catch (AuthorizationException ex) { _error = ex.Message; }
    }
}
