@page "/my-password"
@rendermode InteractiveServer
@inject AuthService Auth
@inject AuditService Audit

<PageTitle>تغيير كلمة المرور</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">تغيير كلمة المرور</h1>
            <p class="page-subtitle">حدّث كلمة مرور حسابك بأمان</p>
        </div>
    </div>

    @if (Auth.CurrentUser == null)
    {
        <div class="error-banner">يجب تسجيل الدخول أولاً</div>
    }
    else
    {
        <div class="panel" style="max-width:520px;margin:0 auto">
            <div class="panel-header"><h3>الحساب: @Auth.CurrentUser.FullName (@Auth.CurrentUser.Username)</h3></div>
            @if (!string.IsNullOrEmpty(_message)) { <div class="success-banner">@_message</div> }
            @if (!string.IsNullOrEmpty(_error)) { <div class="error-banner">@_error</div> }
            <div class="form-grid" style="grid-template-columns:1fr">
                <label>كلمة المرور الحالية<input class="input" type="password" @bind="_current" /></label>
                <label>كلمة المرور الجديدة<input class="input" type="password" @bind="_new" /></label>
                <label>تأكيد كلمة المرور الجديدة<input class="input" type="password" @bind="_confirm" /></label>
            </div>
            <div class="modal-actions" style="justify-content:flex-end">
                <button class="primary-btn" @onclick="Change">🔒 تغيير</button>
            </div>
        </div>
    }
</div>

@code {
    private string _current = "";
    private string _new = "";
    private string _confirm = "";
    private string _message = "";
    private string _error = "";

    private async Task Change()
    {
        _message = ""; _error = "";
        if (Auth.CurrentUser == null) { _error = "يجب تسجيل الدخول"; return; }
        if (string.IsNullOrEmpty(_new) || _new.Length < 4) { _error = "كلمة المرور يجب أن تكون 4 أحرف على الأقل"; return; }
        if (_new != _confirm) { _error = "كلمتا المرور غير متطابقتين"; return; }
        if (AuthService.Hash(_current) != Auth.CurrentUser.PasswordHash) { _error = "كلمة المرور الحالية غير صحيحة"; return; }

        await Auth.SaveUserAsync(Auth.CurrentUser, _new);
        await Audit.LogAsync("تغيير كلمة المرور", "الأمان", Auth.CurrentUser.Username);
        _current = _new = _confirm = "";
        _message = "✅ تم تغيير كلمة المرور بنجاح";
    }
}
