@page "/print/purchase/{Id:int}"
@layout EmptyLayout
@using BusinessSuite.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> Db
@inject CompanySettingsService SettingsSvc

@if (_invoice == null)
{
    <p>جارٍ التحميل...</p>
}
else
{
    <div class="invoice-page">
        <div class="invoice-toolbar no-print">
            <button class="btn-primary" onclick="window.print()">🖨️ طباعة</button>
            <a class="btn-secondary" href="/purchases">عودة للمشتريات</a>
        </div>

        <div class="invoice-paper">
            <div class="invoice-head">
                <div>
                    <h1>فاتورة شراء</h1>
                    <div class="invoice-meta">
                        <div>رقم الفاتورة: <strong>@_invoice.InvoiceNumber</strong></div>
                        <div>التاريخ: @_invoice.Date.ToString("yyyy-MM-dd HH:mm")</div>
                        <div>المورد: @(_invoice.Supplier?.Name ?? "—")</div>
                        <div>الحالة: @_invoice.Status</div>
                    </div>
                </div>
                <div class="invoice-qr">
                    <div style="font-size:3rem">@_settings.LogoEmoji</div>
                    <strong>@_settings.Name</strong>
                    <small>@_settings.TaxNumber</small>
                </div>
            </div>

            <table class="invoice-items">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الصنف</th>
                        <th>الكمية</th>
                        <th>التكلفة</th>
                        <th>الإجمالي</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var it in _invoice.Items)
                    {
                        <tr>
                            <td>@(i++)</td>
                            <td>@it.ProductName</td>
                            <td>@it.Quantity</td>
                            <td>@it.UnitCost.ToString("N2")</td>
                            <td>@it.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="invoice-totals">
                <div class="grand"><span>الإجمالي:</span><strong>@_invoice.Total.ToString("N2") @_settings.Currency</strong></div>
            </div>

            <div class="invoice-footer">
                <p>@_settings.Name — @_settings.Phone — @_settings.Address</p>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private PurchaseInvoice? _invoice;
    private CompanySettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsSvc.GetAsync();
        await using var db = Db.CreateDbContext();
        _invoice = await db.PurchaseInvoices.Include(p => p.Supplier).Include(p => p.Items).FirstOrDefaultAsync(p => p.Id == Id);
    }
}
