@page "/vouchers/{type}"
@rendermode InteractiveServer
@inject AccountingExtendedService AccSvc
@inject AuthService Auth
@inject AuditService Audit

<PageTitle>@Title</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">@Title</h1>
            <p class="page-subtitle">@Subtitle</p>
        </div>
        <div class="page-header-actions">
            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant))
            {
                <button class="primary-btn" @onclick="StartNew">+ سند جديد</button>
            }
        </div>
    </div>

    <div class="stat-grid stat-grid-3">
        <div class="stat-card stat-blue"><div class="stat-icon">📄</div><div class="stat-body"><div class="stat-label">إجمالي السندات</div><div class="stat-value">@_list.Count</div></div></div>
        <div class="stat-card stat-green"><div class="stat-icon">✅</div><div class="stat-body"><div class="stat-label">مرحلة</div><div class="stat-value">@_list.Count(v => v.Status == VoucherStatus.Posted)</div></div></div>
        <div class="stat-card stat-purple"><div class="stat-icon">💰</div><div class="stat-body"><div class="stat-label">المجموع</div><div class="stat-value">@_list.Where(v => v.Status == VoucherStatus.Posted).Sum(v => v.Amount).ToString("N2")</div></div></div>
    </div>

    <div class="panel">
        <table class="table-soft striped">
            <thead><tr><th>الرقم</th><th>التاريخ</th><th>الجهة</th><th>المبلغ</th><th>الطريقة</th><th>الوصف</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
                @if (!_list.Any()) { <tr><td colspan="8" class="empty">لا توجد سندات</td></tr> }
                @foreach (var v in _list)
                {
                    <tr>
                        <td><strong>@v.VoucherNumber</strong></td>
                        <td>@v.Date.ToString("yyyy-MM-dd")</td>
                        <td>@v.PartyName <span class="muted">(@v.PartyType)</span></td>
                        <td><strong>@v.Amount.ToString("N2")</strong></td>
                        <td>@v.PaymentMethod</td>
                        <td>@v.Description</td>
                        <td>@StatusAr(v.Status)</td>
                        <td>
                            @if (v.Status == VoucherStatus.Draft && Auth.HasRole(UserRole.Admin, UserRole.Accountant))
                            {
                                <button class="link" @onclick="() => Post(v.Id)">ترحيل</button>
                                <button class="link danger" @onclick="() => Cancel(v.Id)">إلغاء</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_editing != null)
    {
        <div class="modal-overlay" @onclick="() => _editing = null">
            <div class="modal" @onclick:stopPropagation="true">
                <h3>@Title — جديد</h3>
                <EditForm Model="_editing" OnValidSubmit="Save">
                    <div class="form-grid">
                        <label>التاريخ<input class="input" type="date" @bind="_editing.Date" /></label>
                        <label>المبلغ<input class="input" type="number" step="0.01" @bind="_editing.Amount" required /></label>
                        <label>اسم الجهة<input class="input" @bind="_editing.PartyName" required /></label>
                        <label>نوع الجهة
                            <select class="input" @bind="_editing.PartyType">
                                <option value="عميل">عميل</option>
                                <option value="مورد">مورد</option>
                                <option value="موظف">موظف</option>
                                <option value="أخرى">أخرى</option>
                            </select>
                        </label>
                        <label>طريقة الدفع
                            <select class="input" @bind="_editing.PaymentMethod">
                                <option value="نقدي">نقدي</option>
                                <option value="بطاقة">بطاقة</option>
                                <option value="تحويل بنكي">تحويل بنكي</option>
                                <option value="شيك">شيك</option>
                            </select>
                        </label>
                        <label>المرجع<input class="input" @bind="_editing.Reference" /></label>
                        <label class="full">الوصف<textarea class="input" rows="2" @bind="_editing.Description"></textarea></label>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="ghost-btn" @onclick="() => _editing = null">إلغاء</button>
                        <button type="submit" class="primary-btn">حفظ السند</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Type { get; set; } = "receipt";

    private VoucherType _vt;
    private List<FinancialVoucher> _list = new();
    private FinancialVoucher? _editing;

    private string Title => _vt == VoucherType.Receipt ? "سندات القبض النقدي" : "سندات الصرف النقدي";
    private string Subtitle => _vt == VoucherType.Receipt ? "تسجيل المبالغ المستلمة من العملاء أو الجهات الأخرى" : "تسجيل المبالغ المصروفة للموردين والجهات والموظفين";

    protected override async Task OnParametersSetAsync()
    {
        _vt = Type?.ToLowerInvariant() == "payment" ? VoucherType.Payment : VoucherType.Receipt;
        await Refresh();
    }

    private async Task Refresh() => _list = await AccSvc.GetVouchersAsync(_vt);

    private void StartNew() => _editing = new FinancialVoucher { Type = _vt, Date = DateTime.Today, PaymentMethod = "نقدي", PartyType = _vt == VoucherType.Receipt ? "عميل" : "مورد" };

    private async Task Save()
    {
        if (_editing == null) return;
        await AccSvc.CreateVoucherAsync(_editing);
        await Audit.LogAsync(_vt == VoucherType.Receipt ? "إنشاء سند قبض" : "إنشاء سند صرف", "المحاسبة", $"{_editing.PartyName} {_editing.Amount:N2}");
        _editing = null;
        await Refresh();
    }

    private async Task Post(int id)
    {
        await AccSvc.PostVoucherAsync(id);
        await Audit.LogAsync("ترحيل سند", "المحاسبة", $"ID={id}");
        await Refresh();
    }

    private async Task Cancel(int id)
    {
        await AccSvc.CancelVoucherAsync(id);
        await Refresh();
    }

    private static string StatusAr(VoucherStatus s) => s switch
    {
        VoucherStatus.Draft => "مسودة",
        VoucherStatus.Posted => "مرحل",
        VoucherStatus.Cancelled => "ملغى",
        _ => s.ToString()
    };
}
