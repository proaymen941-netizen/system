@page "/sync"
@rendermode InteractiveServer
@inject AuthService Auth

<PageTitle>المزامنة</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">مزامنة البيانات</h1>
            <p class="page-subtitle">حالة المزامنة مع السيرفر المركزي</p>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header"><h3>الحالة</h3></div>
        <div style="padding:24px;text-align:center">
            <div style="font-size:4rem">@(_online ? "🟢" : "📴")</div>
            <h2>@(_online ? "متصل" : "وضع غير متصل (Offline)")</h2>
            <p class="muted">
                النظام يعمل حالياً بشكل محلي فقط. تحفظ البيانات في قاعدة بيانات SQLite على هذا الجهاز.
                لتفعيل المزامنة الفعلية مع سيرفر مركزي، يجب تشغيل خادم REST/SignalR منفصل وتعيين عنوانه أدناه.
            </p>
            <div class="form-grid" style="grid-template-columns:1fr;max-width:480px;margin:16px auto">
                <label>عنوان السيرفر<input class="input" @bind="_serverUrl" placeholder="https://sync.example.com" /></label>
                <label>مفتاح API<input class="input" type="password" @bind="_apiKey" /></label>
            </div>
            <div class="modal-actions" style="justify-content:center">
                <button class="ghost-btn" @onclick="TestConnection">🔌 اختبار الاتصال</button>
                <button class="primary-btn" @onclick="ManualSync" disabled="@(!_online)">🔄 مزامنة الآن</button>
            </div>
            @if (!string.IsNullOrEmpty(_status)) { <div class="muted" style="margin-top:12px">@_status</div> }
        </div>
    </div>

    <div class="panel">
        <div class="panel-header"><h3>سجل المزامنة</h3></div>
        <table class="table-soft">
            <thead><tr><th>التاريخ</th><th>الحالة</th><th>السجلات</th><th>الملاحظات</th></tr></thead>
            <tbody>
                <tr><td colspan="4" class="empty">لا توجد سجلات مزامنة بعد</td></tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    private bool _online = false;
    private string _serverUrl = "";
    private string _apiKey = "";
    private string _status = "";

    private void TestConnection()
    {
        if (string.IsNullOrWhiteSpace(_serverUrl))
        {
            _status = "⚠️ أدخل عنوان السيرفر أولاً";
            return;
        }
        _status = "❌ تعذّر الاتصال — لا يوجد سيرفر مزامنة قيد التشغيل حالياً";
        _online = false;
    }

    private void ManualSync() => _status = "❌ المزامنة غير متاحة في الوضع المحلي";
}
