@page "/settings"
@inject BackupService Backup
@inject AuditService Audit
@inject AuthService Auth

<PageTitle>الإعدادات</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">الإعدادات</h1>
            <p class="page-subtitle">معلومات النظام، النسخ الاحتياطي، وقاعدة البيانات</p>
        </div>
    </div>

    <div class="grid-2">
        <div class="panel">
            <div class="panel-header"><h3>معلومات النظام</h3></div>
            <ul class="info-list">
                <li><span>الاسم</span><strong>النظام المتكامل لإدارة الأعمال</strong></li>
                <li><span>الإصدار</span><strong>1.1.0</strong></li>
                <li><span>التقنية</span><strong>ASP.NET Core 8 — Blazor Server (C#)</strong></li>
                <li><span>قاعدة البيانات</span><strong>SQLite (محلية)</strong></li>
                <li><span>المستخدم الحالي</span><strong>@(Auth.CurrentUser?.FullName)</strong></li>
                <li><span>اللغة</span><strong>العربية (RTL)</strong></li>
            </ul>
        </div>
        <div class="panel">
            <div class="panel-header"><h3>الوحدات المفعّلة</h3></div>
            <ul class="info-list">
                <li><span>📊 لوحة التحكم</span><span class="tag tag-success">مفعّل</span></li>
                <li><span>🛒 نقطة البيع (POS)</span><span class="tag tag-success">مفعّل</span></li>
                <li><span>📦 المخازن</span><span class="tag tag-success">مفعّل</span></li>
                <li><span>🧾 المشتريات والمبيعات</span><span class="tag tag-success">مفعّل</span></li>
                <li><span>💰 المحاسبة</span><span class="tag tag-success">مفعّل</span></li>
                <li><span>👥 الموارد البشرية</span><span class="tag tag-success">مفعّل</span></li>
                <li><span>🔐 الصلاحيات والمستخدمون</span><span class="tag tag-success">مفعّل</span></li>
                <li><span>📜 سجل العمليات</span><span class="tag tag-success">مفعّل</span></li>
                <li><span>🧾 الفواتير الإلكترونية + QR</span><span class="tag tag-success">مفعّل</span></li>
                <li><span>🔔 الإشعارات</span><span class="tag tag-success">مفعّل</span></li>
            </ul>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h3>النسخ الاحتياطي</h3>
            <div>
                <a class="btn-secondary" href="/download/db" target="_blank">⬇️ تحميل نسخة فورية من قاعدة البيانات</a>
                @if (Auth.HasRole(UserRole.Admin))
                {
                    <button class="btn-primary" @onclick="DoBackup">💾 إنشاء نسخة احتياطية</button>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="success-banner">@_message</div>
        }
        <table class="table-soft">
            <thead><tr><th>اسم الملف</th><th>تاريخ الإنشاء</th><th>الحجم</th><th></th></tr></thead>
            <tbody>
                @if (_backups.Count == 0)
                {
                    <tr><td colspan="4" class="empty">لا توجد نسخ احتياطية بعد</td></tr>
                }
                @foreach (var b in _backups)
                {
                    <tr>
                        <td><code>@b.Name</code></td>
                        <td>@b.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@((b.Size / 1024.0).ToString("N1")) KB</td>
                        <td>
                            <a class="btn-link" href="@($"/download/backup/{b.Name}")" target="_blank">⬇️ تحميل</a>
                            @if (Auth.HasRole(UserRole.Admin))
                            {
                                <button class="btn-link danger" @onclick="() => DeleteBackup(b.Name)">حذف</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="muted" style="padding: 12px;">
            💡 ملف قاعدة البيانات يُحفظ محلياً في: <code>AppData/businesssuite.db</code>.
            النسخ الاحتياطية تُحفظ في: <code>AppData/Backups/</code>.
        </div>
    </div>
</div>

@code {
    private List<BackupFile> _backups = new();
    private string _message = "";

    protected override void OnInitialized() => Reload();
    private void Reload() => _backups = Backup.ListBackups();

    private async Task DoBackup()
    {
        var path = Backup.CreateBackup();
        await Audit.LogAsync("نسخ احتياطي", "النظام", Path.GetFileName(path));
        _message = $"✅ تم إنشاء نسخة احتياطية: {Path.GetFileName(path)}";
        Reload();
    }

    private async Task DeleteBackup(string name)
    {
        Backup.DeleteBackup(name);
        await Audit.LogAsync("حذف نسخة احتياطية", "النظام", name);
        _message = $"🗑️ تم حذف النسخة: {name}";
        Reload();
    }
}
