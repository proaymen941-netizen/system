@inject AuthService Auth
@inject LicenseService LicenseSvc
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="login-shell">
    <div class="login-card">
        <div class="login-brand">
            <div class="brand-logo big">🌿</div>
            <h1>النظام المتكامل لإدارة الأعمال</h1>
            <p>سجّل دخولك للمتابعة</p>
        </div>

        <div class="login-tabs">
            <button class="login-tab @(_byNumber ? "" : "active")" @onclick='() => { _byNumber = false; Error = null; }'>اسم المستخدم</button>
            <button class="login-tab @(_byNumber ? "active" : "")" @onclick='() => { _byNumber = true; Error = null; }'>رقم المستخدم</button>
        </div>

        <EditForm Model="this" OnValidSubmit="DoLogin" class="login-form">
            @if (_byNumber)
            {
                <label>رقم المستخدم</label>
                <input type="number" @bind="UserNumber" placeholder="مثال: 101" autofocus />
            }
            else
            {
                <label>اسم المستخدم</label>
                <input @bind="Username" placeholder="admin" autofocus />
            }

            <label>كلمة المرور</label>
            <input type="password" @bind="Password" placeholder="••••••" />

            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="login-error">@Error</div>
            }

            @if (!string.IsNullOrEmpty(_deviceInfo))
            {
                <div class="muted" style="font-size:12px;text-align:center;margin-top:6px">
                    🖥️ @_deviceInfo
                </div>
            }

            <button type="submit" class="btn-primary login-btn" disabled="@_busy">
                @(_busy ? "جاري التحقق..." : "دخول")
            </button>
        </EditForm>

    </div>
</div>

@code {
    [Parameter] public EventCallback OnLoggedIn { get; set; }
    private string Username { get; set; } = "";
    private int? UserNumber { get; set; }
    private string Password { get; set; } = "";
    private string? Error;
    private bool _busy;
    private bool _byNumber;
    private string _deviceInfo = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var name = await JS.InvokeAsync<string>("deviceFingerprint.getDeviceName");
                _deviceInfo = $"الجهاز: {name}";
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task DoLogin()
    {
        Error = null;
        _busy = true;
        try
        {
            // Step 1: validate credentials
            bool ok;
            if (_byNumber && UserNumber.HasValue)
                ok = await Auth.LoginByNumberAsync(UserNumber.Value, Password);
            else
                ok = await Auth.LoginAsync(Username.Trim(), Password);

            if (!ok) { Error = "بيانات الدخول غير صحيحة"; return; }

            // Step 2: register/check device
            try
            {
                var fp = await JS.InvokeAsync<string>("deviceFingerprint.get");
                var name = await JS.InvokeAsync<string>("deviceFingerprint.getDeviceName");
                var ua = await JS.InvokeAsync<string>("deviceFingerprint.getUserAgent");

                var kind = Auth.CurrentUser!.Role switch
                {
                    UserRole.Admin => DeviceKind.Manager,
                    UserRole.Cashier => DeviceKind.Cashier,
                    UserRole.Accountant => DeviceKind.Accountant,
                    _ => DeviceKind.Manager
                };

                // Admin always allowed (so admin can manage license even if devices exhausted)
                if (Auth.CurrentUser.Role != UserRole.Admin)
                {
                    var result = await LicenseSvc.RegisterOrCheckAsync(fp, kind, "browser", ua, name);
                    if (result.Status == LicenseService.RegistrationResult.LimitReached
                     || result.Status == LicenseService.RegistrationResult.LicenseExpired
                     || result.Status == LicenseService.RegistrationResult.LicenseInactive
                     || result.Status == LicenseService.RegistrationResult.Blocked)
                    {
                        Auth.Logout();
                        Error = result.Message;
                        return;
                    }
                }
                else
                {
                    // Always register admin device (without enforcing limits hard for admin)
                    await LicenseSvc.RegisterOrCheckAsync(fp, DeviceKind.Manager, "browser", ua, name);
                }
            }
            catch (Exception ex)
            {
                // If JS interop fails for any reason, still allow admin in but warn cashier
                if (Auth.CurrentUser?.Role != UserRole.Admin)
                {
                    Auth.Logout();
                    Error = "تعذر التحقق من بصمة الجهاز: " + ex.Message;
                    return;
                }
            }

            await OnLoggedIn.InvokeAsync();
        }
        finally { _busy = false; }
    }
}
