@page "/sales"
@rendermode InteractiveServer
@inject PosService Pos
@inject AuthService Auth
@inject AuditService Audit

<PageTitle>المبيعات</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">سجل المبيعات</h1>
            <p class="page-subtitle">جميع فواتير البيع المسجلة</p>
        </div>
        <div class="page-header-actions">
            <a class="ghost-btn" href="@ExportUrl("csv")" target="_blank">⬇️ CSV</a>
            <a class="ghost-btn" href="@ExportUrl("xlsx")" target="_blank">📊 Excel</a>
            <a class="primary-btn" href="/pos">+ بيع جديد</a>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header"><h3>الفلاتر</h3></div>
        <div class="form-grid">
            <label>من<input class="input" type="date" @bind="_from" @bind:after="Refresh" /></label>
            <label>إلى<input class="input" type="date" @bind="_to" @bind:after="Refresh" /></label>
            <label>الحالة
                <select class="input" @bind="_status" @bind:after="Refresh">
                    <option value="">— الكل —</option>
                    <option value="active">نشطة فقط</option>
                    <option value="cancelled">ملغاة</option>
                    <option value="Paid">مدفوعة</option>
                    <option value="Unpaid">غير مدفوعة</option>
                    <option value="PartiallyPaid">مدفوعة جزئياً</option>
                    <option value="Refunded">مسترجعة</option>
                </select>
            </label>
            <label>بحث<input class="input" placeholder="رقم/عميل" @bind="_search" @bind:event="oninput" @bind:after="Refresh" /></label>
        </div>
    </div>

    @if (_sales != null)
    {
        <div class="stat-grid stat-grid-3">
            <div class="stat-card stat-green"><div class="stat-icon">💵</div><div class="stat-body"><div class="stat-label">إجمالي المبيعات</div><div class="stat-value">@_sales.Where(s => !s.IsCancelled).Sum(s => s.Total).ToString("N0") <span class="stat-unit">ريال</span></div></div></div>
            <div class="stat-card stat-blue"><div class="stat-icon">🧾</div><div class="stat-body"><div class="stat-label">عدد الفواتير</div><div class="stat-value">@_sales.Count</div></div></div>
            <div class="stat-card stat-orange"><div class="stat-icon">⚠️</div><div class="stat-body"><div class="stat-label">غير مدفوعة</div><div class="stat-value">@_sales.Count(s => !s.IsCancelled && s.PaymentStatus != InvoicePaymentStatus.Paid)</div></div></div>
        </div>

        @if (!string.IsNullOrEmpty(_error)) { <div class="error-banner">@_error</div> }

        <div class="panel">
            <div class="panel-header"><h3>الفواتير</h3></div>
            <table class="table-soft striped">
                <thead><tr><th>الرقم</th><th>التاريخ</th><th>العميل</th><th>الدفع</th><th>الحالة</th><th>الإجمالي</th><th></th></tr></thead>
                <tbody>
                    @if (!_sales.Any())
                    {
                        <tr><td colspan="7" class="empty">لا توجد فواتير</td></tr>
                    }
                    @foreach (var s in _sales)
                    {
                        <tr class="@(s.IsCancelled ? "row-cancelled" : "")">
                            <td><strong>@s.InvoiceNumber</strong></td>
                            <td>@s.Date.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@s.CustomerName</td>
                            <td>
                                @if (s.PaymentMethod == "نقدي") { <span class="tag tag-success">نقدي</span> }
                                else if (s.PaymentMethod == "بطاقة") { <span class="tag tag-info">بطاقة</span> }
                                else { <span class="tag tag-muted">@s.PaymentMethod</span> }
                            </td>
                            <td>
                                @if (s.IsCancelled) { <span class="tag tag-danger">ملغاة</span> }
                                else
                                {
                                    @switch (s.PaymentStatus)
                                    {
                                        case InvoicePaymentStatus.Paid: <span class="tag tag-success">مدفوعة</span> break;
                                        case InvoicePaymentStatus.Unpaid: <span class="tag tag-warning">غير مدفوعة</span> break;
                                        case InvoicePaymentStatus.PartiallyPaid: <span class="tag tag-info">جزئية</span> break;
                                        case InvoicePaymentStatus.Refunded: <span class="tag tag-danger">مسترجعة</span> break;
                                    }
                                }
                            </td>
                            <td><strong>@s.Total.ToString("N2")</strong></td>
                            <td>
                                <a class="link" href="@($"/print/sale/{s.Id}")" target="_blank">🖨️</a>
                                @if (!s.IsCancelled && Auth.HasRole(UserRole.Admin, UserRole.Accountant))
                                {
                                    @if (s.PaymentStatus != InvoicePaymentStatus.Paid)
                                    {
                                        <button class="link" @onclick="() => MarkPaid(s.Id)">تحصيل</button>
                                    }
                                    <button class="link danger" @onclick="() => StartCancel(s)">إلغاء</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_cancelling != null)
    {
        <div class="modal-overlay" @onclick="() => _cancelling = null">
            <div class="modal" @onclick:stopPropagation="true">
                <h3>إلغاء فاتورة @_cancelling.InvoiceNumber</h3>
                <p class="muted">سيتم إعادة الكميات للمخزون وتسجيل قيد عكسي.</p>
                <label>سبب الإلغاء<input class="input" @bind="_cancelReason" /></label>
                <div class="modal-actions">
                    <button type="button" class="ghost-btn" @onclick="() => _cancelling = null">تراجع</button>
                    <button type="button" class="primary-btn" @onclick="ConfirmCancel">تأكيد الإلغاء</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<SaleInvoice>? _sales;
    private DateTime? _from;
    private DateTime? _to;
    private string _status = "";
    private string _search = "";
    private SaleInvoice? _cancelling;
    private string _cancelReason = "";
    private string _error = "";

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh() => _sales = await Pos.GetRecentSalesAsync(500, _from, _to, _status, _search);

    private void StartCancel(SaleInvoice s) { _cancelling = s; _cancelReason = ""; _error = ""; }

    private async Task ConfirmCancel()
    {
        if (_cancelling == null) return;
        try
        {
            await Pos.CancelSaleAsync(_cancelling.Id, string.IsNullOrEmpty(_cancelReason) ? "إلغاء" : _cancelReason);
            await Audit.LogAsync("إلغاء فاتورة", "المبيعات", $"{_cancelling.InvoiceNumber} - {_cancelReason}");
            _cancelling = null;
            await Refresh();
        }
        catch (AuthorizationException ex) { _error = ex.Message; _cancelling = null; }
    }

    private async Task MarkPaid(int id)
    {
        try
        {
            await Pos.SetPaymentStatusAsync(id, InvoicePaymentStatus.Paid);
            await Audit.LogAsync("تحصيل فاتورة", "المبيعات", $"ID={id}");
            await Refresh();
        }
        catch (AuthorizationException ex) { _error = ex.Message; }
    }

    private string ExportUrl(string format)
    {
        var qs = new List<string>();
        if (_from.HasValue) qs.Add($"from={_from:yyyy-MM-dd}");
        if (_to.HasValue) qs.Add($"to={_to:yyyy-MM-dd}");
        if (!string.IsNullOrEmpty(_status)) qs.Add($"status={_status}");
        return $"/export/sales.{format}" + (qs.Any() ? "?" + string.Join("&", qs) : "");
    }
}
