@page "/cashier-shifts"
@rendermode InteractiveServer
@inject CashierShiftService ShiftSvc
@inject AuthService Auth
@inject CompanySettingsService SettingsSvc
@inject NavigationManager Nav

<PageTitle>إدارة الورديات</PageTitle>

@if (!Auth.HasRole(UserRole.Admin, UserRole.Accountant))
{
    <div class="page"><div class="error-banner">⚠️ هذه الصفحة متاحة للمدير والمحاسب فقط</div></div>
}
else
{
    <div class="page">
        <div class="page-header">
            <div>
                <h1 class="page-title">إدارة الورديات</h1>
                <p class="page-subtitle">سجل ورديات الكاشير وتقارير المبيعات</p>
            </div>
        </div>

        <div class="panel" style="margin-bottom:1rem">
            <div class="panel-header"><h3>بحث وتصفية</h3></div>
            <div class="form-grid" style="padding:1rem">
                <label>من تاريخ<input class="input" type="date" @bind="_from" /></label>
                <label>إلى تاريخ<input class="input" type="date" @bind="_to" /></label>
                <div style="align-self:flex-end">
                    <button class="primary-btn" @onclick="Load">🔍 بحث</button>
                </div>
            </div>
        </div>

        @if (_loading)
        {
            <div class="muted" style="padding:2rem;text-align:center">جارٍ التحميل...</div>
        }
        else
        {
            <div class="panel">
                <div class="panel-header">
                    <h3>الورديات (@_shifts.Count)</h3>
                </div>
                @if (!_shifts.Any())
                {
                    <div class="empty-state">لا توجد ورديات في الفترة المحددة</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>الكاشير</th>
                                    <th>فُتحت</th>
                                    <th>أُغلقت</th>
                                    <th>الحالة</th>
                                    <th>الفواتير</th>
                                    <th>إجمالي المبيعات</th>
                                    <th>نقدي</th>
                                    <th>بطاقة</th>
                                    <th>أخرى</th>
                                    <th>رصيد افتتاحي</th>
                                    <th>رصيد ختامي</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in _shifts)
                                {
                                    <tr>
                                        <td>@s.Id</td>
                                        <td><strong>@s.CashierName</strong></td>
                                        <td>@s.OpenedAt.ToString("yyyy/MM/dd hh:mm tt")</td>
                                        <td>@(s.ClosedAt.HasValue ? s.ClosedAt.Value.ToString("yyyy/MM/dd hh:mm tt") : "—")</td>
                                        <td>
                                            @if (s.IsClosed)
                                            {
                                                <span class="tag tag-success">مغلقة</span>
                                            }
                                            else
                                            {
                                                <span class="tag tag-warning">مفتوحة</span>
                                            }
                                        </td>
                                        <td>@s.InvoiceCount</td>
                                        <td><strong>@s.TotalSales.ToString("N2") @_currency</strong></td>
                                        <td>@s.TotalCash.ToString("N2")</td>
                                        <td>@s.TotalCard.ToString("N2")</td>
                                        <td>@s.TotalOther.ToString("N2")</td>
                                        <td>@s.OpeningCash.ToString("N2")</td>
                                        <td>@s.ClosingCash.ToString("N2")</td>
                                        <td>
                                            <button class="btn-sm" @onclick="() => ShowDetail(s)">📋 تفاصيل</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="summary-row">
                                    <td colspan="5"><strong>الإجمالي</strong></td>
                                    <td><strong>@_shifts.Sum(s => s.InvoiceCount)</strong></td>
                                    <td><strong>@_shifts.Sum(s => s.TotalSales).ToString("N2") @_currency</strong></td>
                                    <td><strong>@_shifts.Sum(s => s.TotalCash).ToString("N2")</strong></td>
                                    <td><strong>@_shifts.Sum(s => s.TotalCard).ToString("N2")</strong></td>
                                    <td><strong>@_shifts.Sum(s => s.TotalOther).ToString("N2")</strong></td>
                                    <td colspan="3"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        }

        @if (_selectedShift != null)
        {
            <div class="modal-overlay">
                <div class="modal" style="max-width:680px;max-height:80vh;overflow-y:auto">
                    <div class="modal-header">
                        <h3>تفاصيل الوردية — @_selectedShift.CashierName</h3>
                    </div>
                    <div class="modal-body">
                        <div class="shift-detail-grid">
                            <div class="sd-card">
                                <div class="sd-label">الكاشير</div>
                                <div class="sd-value">@_selectedShift.CashierName</div>
                            </div>
                            <div class="sd-card">
                                <div class="sd-label">وقت الفتح</div>
                                <div class="sd-value">@_selectedShift.OpenedAt.ToString("yyyy/MM/dd hh:mm tt")</div>
                            </div>
                            <div class="sd-card">
                                <div class="sd-label">وقت الإغلاق</div>
                                <div class="sd-value">@(_selectedShift.ClosedAt.HasValue ? _selectedShift.ClosedAt.Value.ToString("yyyy/MM/dd hh:mm tt") : "لم تُغلق")</div>
                            </div>
                            <div class="sd-card">
                                <div class="sd-label">عدد الفواتير</div>
                                <div class="sd-value big">@_selectedShift.InvoiceCount</div>
                            </div>
                            <div class="sd-card highlight">
                                <div class="sd-label">إجمالي المبيعات</div>
                                <div class="sd-value big">@_selectedShift.TotalSales.ToString("N2") @_currency</div>
                            </div>
                            <div class="sd-card">
                                <div class="sd-label">نقدي</div>
                                <div class="sd-value">@_selectedShift.TotalCash.ToString("N2") @_currency</div>
                            </div>
                            <div class="sd-card">
                                <div class="sd-label">بطاقة</div>
                                <div class="sd-value">@_selectedShift.TotalCard.ToString("N2") @_currency</div>
                            </div>
                            <div class="sd-card">
                                <div class="sd-label">أخرى</div>
                                <div class="sd-value">@_selectedShift.TotalOther.ToString("N2") @_currency</div>
                            </div>
                            <div class="sd-card">
                                <div class="sd-label">رصيد افتتاحي</div>
                                <div class="sd-value">@_selectedShift.OpeningCash.ToString("N2") @_currency</div>
                            </div>
                            <div class="sd-card">
                                <div class="sd-label">رصيد ختامي</div>
                                <div class="sd-value">@_selectedShift.ClosingCash.ToString("N2") @_currency</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_selectedShift.Notes))
                        {
                            <div style="margin-top:1rem">
                                <strong>ملاحظات:</strong>
                                <p class="muted">@_selectedShift.Notes</p>
                            </div>
                        }

                        @if (_shiftInvoices.Any())
                        {
                            <div style="margin-top:1.5rem">
                                <h4 style="margin-bottom:.5rem">فواتير الوردية (@_shiftInvoices.Count)</h4>
                                <div class="table-wrap" style="max-height:300px;overflow-y:auto">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>رقم الفاتورة</th>
                                                <th>الوقت</th>
                                                <th>العميل</th>
                                                <th>نوع الطلب</th>
                                                <th>طريقة الدفع</th>
                                                <th>الإجمالي</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var inv in _shiftInvoices)
                                            {
                                                <tr class="@(inv.IsCancelled ? "row-cancelled" : "")">
                                                    <td>@inv.InvoiceNumber</td>
                                                    <td>@inv.Date.ToString("hh:mm tt")</td>
                                                    <td>@inv.CustomerName</td>
                                                    <td>@inv.OrderType</td>
                                                    <td>@inv.PaymentMethod</td>
                                                    <td><strong>@inv.Total.ToString("N2")</strong></td>
                                                    <td><a href="/print/sale/@inv.Id" target="_blank" class="btn-sm">🖨️</a></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-actions">
                        <button class="secondary-btn" @onclick="() => _selectedShift = null">إغلاق</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<CashierShift> _shifts = new();
    private List<SaleInvoice> _shiftInvoices = new();
    private CashierShift? _selectedShift;
    private DateTime? _from;
    private DateTime? _to;
    private bool _loading;
    private string _currency = "ر.س";

    protected override async Task OnInitializedAsync()
    {
        var s = await SettingsSvc.GetAsync();
        _currency = s.Currency;
        _from = DateTime.Today.AddDays(-30);
        _to = DateTime.Today;
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _shifts = await ShiftSvc.GetShiftsAsync(_from, _to);
        _loading = false;
    }

    private async Task ShowDetail(CashierShift shift)
    {
        _selectedShift = shift;
        _shiftInvoices = await ShiftSvc.GetShiftInvoicesAsync(shift.Id);
    }
}
