@page "/accounting"
@rendermode InteractiveServer
@inject AccountingService AcctSvc
@inject AuthService Auth
@inject AuditService Audit

<PageTitle>المحاسبة</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">النظام المحاسبي</h1>
            <p class="page-subtitle">القيود اليومية، الإيرادات والمصروفات</p>
        </div>
        <div class="page-header-actions">
            <a class="ghost-btn" href="/trial-balance">📊 ميزان المراجعة</a>
            <a class="ghost-btn" href="@ExportUrl("csv")" target="_blank">⬇️ CSV</a>
            <a class="ghost-btn" href="@ExportUrl("xlsx")" target="_blank">📊 Excel</a>
            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant))
            {
                <button class="primary-btn" @onclick="StartNew">+ قيد جديد</button>
            }
        </div>
    </div>

    @if (_summary != null)
    {
        <div class="stat-grid">
            <div class="stat-card stat-green"><div class="stat-icon">💵</div><div class="stat-body"><div class="stat-label">الإيرادات</div><div class="stat-value">@_summary.Income.ToString("N0") <span class="stat-unit">ريال</span></div></div></div>
            <div class="stat-card stat-orange"><div class="stat-icon">💸</div><div class="stat-body"><div class="stat-label">المصروفات</div><div class="stat-value">@_summary.Expense.ToString("N0") <span class="stat-unit">ريال</span></div></div></div>
            <div class="stat-card stat-purple"><div class="stat-icon">📈</div><div class="stat-body"><div class="stat-label">صافي الربح</div><div class="stat-value">@_summary.NetProfit.ToString("N0") <span class="stat-unit">ريال</span></div></div></div>
            <div class="stat-card stat-blue"><div class="stat-icon">📦</div><div class="stat-body"><div class="stat-label">قيمة المخزون</div><div class="stat-value">@_summary.Inventory.ToString("N0") <span class="stat-unit">ريال</span></div></div></div>
        </div>
    }

    <div class="panel">
        <div class="panel-header"><h3>الفلاتر</h3></div>
        <div class="form-grid">
            <label>من<input class="input" type="date" @bind="_from" @bind:after="Refresh" /></label>
            <label>إلى<input class="input" type="date" @bind="_to" @bind:after="Refresh" /></label>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error)) { <div class="error-banner">@_error</div> }

    <div class="panel">
        <div class="panel-header"><h3>القيود اليومية</h3></div>
        <table class="table-soft striped">
            <thead><tr><th>التاريخ</th><th>النوع</th><th>الفئة</th><th>الوصف</th><th>المبلغ</th><th>المرجع</th><th></th></tr></thead>
            <tbody>
                @if (!_entries.Any())
                {
                    <tr><td colspan="7" class="empty">لا توجد قيود</td></tr>
                }
                @foreach (var e in _entries)
                {
                    <tr>
                        <td>@e.Date.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (e.Type == EntryType.Income) { <span class="tag tag-success">إيراد</span> }
                            else { <span class="tag tag-danger">مصروف</span> }
                        </td>
                        <td>@e.Category</td>
                        <td>@e.Description</td>
                        <td><strong class="@(e.Type == EntryType.Income ? "text-green" : "text-red")">@e.Amount.ToString("N2")</strong></td>
                        <td class="muted">@e.Reference</td>
                        <td>
                            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant))
                            {
                                <button class="link" @onclick="() => Edit(e)">تعديل</button>
                                <button class="link danger" @onclick="() => Delete(e.Id)">حذف</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_editing != null)
    {
        <div class="modal-overlay" @onclick="Cancel">
            <div class="modal" @onclick:stopPropagation="true">
                <h3>@(_editing.Id == 0 ? "قيد محاسبي جديد" : "تعديل قيد")</h3>
                <EditForm Model="_editing" OnValidSubmit="Save">
                    <div class="form-grid">
                        <label>التاريخ<input class="input" type="date" @bind="_editing.Date" /></label>
                        <label>النوع
                            <select class="input" @bind="_editing.Type">
                                <option value="@EntryType.Income">إيراد</option>
                                <option value="@EntryType.Expense">مصروف</option>
                            </select>
                        </label>
                        <label>الفئة<input class="input" @bind="_editing.Category" required /></label>
                        <label>المرجع<input class="input" @bind="_editing.Reference" /></label>
                        <label class="full">الوصف<input class="input" @bind="_editing.Description" /></label>
                        <label>المبلغ<input class="input" type="number" step="0.01" @bind="_editing.Amount" /></label>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="ghost-btn" @onclick="Cancel">إلغاء</button>
                        <button type="submit" class="primary-btn">حفظ</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private List<JournalEntry> _entries = new();
    private FinancialSummary? _summary;
    private JournalEntry? _editing;
    private DateTime? _from;
    private DateTime? _to;
    private string _error = "";

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh()
    {
        _entries = await AcctSvc.GetEntriesAsync(_from, _to);
        _summary = await AcctSvc.GetSummaryAsync(_from, _to);
    }

    private void StartNew() => _editing = new JournalEntry { Date = DateTime.Today };
    private void Edit(JournalEntry e) => _editing = new JournalEntry { Id = e.Id, Date = e.Date, Type = e.Type, Category = e.Category, Description = e.Description, Amount = e.Amount, Reference = e.Reference };
    private void Cancel() { _editing = null; _error = ""; }

    private async Task Save()
    {
        if (_editing == null) return;
        try
        {
            await AcctSvc.SaveEntryAsync(_editing);
            await Audit.LogAsync(_editing.Id == 0 ? "إضافة قيد" : "تعديل قيد", "المحاسبة", $"{_editing.Category} - {_editing.Amount}");
            _editing = null;
            await Refresh();
        }
        catch (AuthorizationException ex) { _error = ex.Message; }
    }

    private async Task Delete(int id)
    {
        try
        {
            await AcctSvc.DeleteEntryAsync(id);
            await Audit.LogAsync("حذف قيد", "المحاسبة", $"ID={id}");
            await Refresh();
        }
        catch (AuthorizationException ex) { _error = ex.Message; }
    }

    private string ExportUrl(string format)
    {
        var qs = new List<string>();
        if (_from.HasValue) qs.Add($"from={_from:yyyy-MM-dd}");
        if (_to.HasValue) qs.Add($"to={_to:yyyy-MM-dd}");
        return $"/export/journal.{format}" + (qs.Any() ? "?" + string.Join("&", qs) : "");
    }
}
