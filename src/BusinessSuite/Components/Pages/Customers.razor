@page "/customers"
@rendermode InteractiveServer
@inject CustomerService CustomerSvc
@inject AuthService Auth
@inject AuditService Audit

<PageTitle>العملاء</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">إدارة العملاء</h1>
            <p class="page-subtitle">قاعدة بيانات العملاء والأرصدة</p>
        </div>
        <div class="page-header-actions">
            <a class="ghost-btn" href="/export/customers.csv" target="_blank">⬇️ CSV</a>
            <a class="ghost-btn" href="/export/customers.xlsx" target="_blank">📊 Excel</a>
            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant, UserRole.Cashier))
            {
                <button class="primary-btn" @onclick="StartNew">+ عميل جديد</button>
            }
        </div>
    </div>

    <div class="stat-grid stat-grid-3">
        <div class="stat-card stat-blue"><div class="stat-icon">👥</div><div class="stat-body"><div class="stat-label">إجمالي العملاء</div><div class="stat-value">@_customers.Count</div></div></div>
        <div class="stat-card stat-green"><div class="stat-icon">💵</div><div class="stat-body"><div class="stat-label">عملاء برصيد</div><div class="stat-value">@_customers.Count(c => c.Balance > 0)</div></div></div>
        <div class="stat-card stat-purple"><div class="stat-icon">💰</div><div class="stat-body"><div class="stat-label">إجمالي المستحقات</div><div class="stat-value">@_customers.Sum(c => c.Balance).ToString("N0")</div></div></div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h3>قائمة العملاء</h3>
            <input class="input-search" placeholder="بحث بالاسم/الهاتف..." @bind="_search" @bind:event="oninput" @bind:after="Refresh" />
        </div>
        <table class="table-soft striped">
            <thead><tr><th>الاسم</th><th>الهاتف</th><th>البريد</th><th>الرقم الضريبي</th><th>الرصيد</th><th></th></tr></thead>
            <tbody>
                @if (!_customers.Any())
                {
                    <tr><td colspan="6" class="empty">لا يوجد عملاء</td></tr>
                }
                @foreach (var c in _customers)
                {
                    <tr>
                        <td><div class="cell-avatar"><div class="avatar small">@c.Name.FirstOrDefault()</div>@c.Name</div></td>
                        <td dir="ltr">@c.Phone</td>
                        <td>@c.Email</td>
                        <td dir="ltr">@c.TaxNumber</td>
                        <td><strong class="@(c.Balance > 0 ? "text-orange" : "")">@c.Balance.ToString("N2")</strong></td>
                        <td>
                            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant, UserRole.Cashier))
                            {
                                <button class="link" @onclick="() => Edit(c)">تعديل</button>
                            }
                            @if (Auth.HasRole(UserRole.Admin, UserRole.Accountant))
                            {
                                <button class="link danger" @onclick="() => Delete(c.Id)">حذف</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_editing != null)
    {
        <div class="modal-overlay" @onclick="Cancel">
            <div class="modal" @onclick:stopPropagation="true">
                <h3>@(_editing.Id == 0 ? "إضافة عميل" : "تعديل عميل")</h3>
                @if (!string.IsNullOrEmpty(_error)) { <div class="error-banner">@_error</div> }
                <EditForm Model="_editing" OnValidSubmit="Save">
                    <div class="form-grid">
                        <label>الاسم<input class="input" @bind="_editing.Name" required /></label>
                        <label>الهاتف<input class="input" @bind="_editing.Phone" /></label>
                        <label>البريد<input class="input" @bind="_editing.Email" /></label>
                        <label>الرقم الضريبي<input class="input" @bind="_editing.TaxNumber" /></label>
                        <label class="full">العنوان<input class="input" @bind="_editing.Address" /></label>
                        <label>الرصيد المستحق<input class="input" type="number" step="0.01" @bind="_editing.Balance" /></label>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="ghost-btn" @onclick="Cancel">إلغاء</button>
                        <button type="submit" class="primary-btn">حفظ</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private List<Customer> _customers = new();
    private Customer? _editing;
    private string _search = "";
    private string _error = "";

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh() => _customers = await CustomerSvc.GetAsync(_search);

    private void StartNew() => _editing = new Customer();
    private void Edit(Customer c) => _editing = new Customer { Id = c.Id, Name = c.Name, Phone = c.Phone, Email = c.Email, TaxNumber = c.TaxNumber, Address = c.Address, Balance = c.Balance };
    private void Cancel() { _editing = null; _error = ""; }

    private async Task Save()
    {
        if (_editing == null) return;
        try
        {
            await CustomerSvc.SaveAsync(_editing);
            await Audit.LogAsync(_editing.Id == 0 ? "إضافة عميل" : "تعديل عميل", "العملاء", _editing.Name);
            _editing = null;
            await Refresh();
        }
        catch (AuthorizationException ex) { _error = ex.Message; }
    }

    private async Task Delete(int id)
    {
        try
        {
            await CustomerSvc.DeleteAsync(id);
            await Audit.LogAsync("حذف عميل", "العملاء", $"ID={id}");
            await Refresh();
        }
        catch (AuthorizationException ex) { _error = ex.Message; }
    }
}
