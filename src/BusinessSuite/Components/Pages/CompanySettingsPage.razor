@page "/company-settings"
@rendermode InteractiveServer
@inject CompanySettingsService SettingsSvc
@inject AuthService Auth
@inject AuditService Audit

<PageTitle>إعدادات الشركة</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1 class="page-title">إعدادات الشركة</h1>
            <p class="page-subtitle">المعلومات الأساسية، العملة، الضريبة، الإيصالات</p>
        </div>
    </div>

    @if (!Auth.HasRole(UserRole.Admin))
    {
        <div class="error-banner">⚠️ هذه الصفحة متاحة لمدير النظام فقط</div>
    }
    else if (_settings != null)
    {
        @if (!string.IsNullOrEmpty(_message)) { <div class="success-banner">@_message</div> }
        @if (!string.IsNullOrEmpty(_error)) { <div class="error-banner">@_error</div> }

        <div class="panel">
            <div class="panel-header"><h3>المعلومات الأساسية</h3></div>
            <EditForm Model="_settings" OnValidSubmit="Save">
                <div class="form-grid" style="padding:1rem">
                    <label>اسم الشركة<input class="input" @bind="_settings.Name" required /></label>
                    <label>الرمز/الشعار (إيموجي)<input class="input" @bind="_settings.LogoEmoji" /></label>
                    <label>الرقم الضريبي<input class="input" @bind="_settings.TaxNumber" /></label>
                    <label>السجل التجاري<input class="input" @bind="_settings.CommercialRegister" /></label>
                    <label>الهاتف<input class="input" @bind="_settings.Phone" /></label>
                    <label>البريد الإلكتروني<input class="input" @bind="_settings.Email" /></label>
                    <label class="full">العنوان<input class="input" @bind="_settings.Address" /></label>
                    <label>العملة<input class="input" @bind="_settings.Currency" /></label>
                    <label>نسبة الضريبة (%)<input class="input" type="number" step="0.01" min="0" max="100" @bind="_settings.TaxRate" /></label>
                </div>
                <div class="panel-header" style="margin-top:.5rem"><h3>بيانات الفرع</h3></div>
                <div class="form-grid" style="padding:1rem">
                    <label>رقم الفرع (Branch Code)<input class="input" @bind="_settings.BranchCode" placeholder="مثال: 01" dir="ltr" /></label>
                    <label>السنة المالية (Financial Year)<input class="input" @bind="_settings.FinancialYear" placeholder="2026" dir="ltr" /></label>
                    <label>اسم الفرع بالعربي (Arabic Name)<input class="input" @bind="_settings.ArabicName" /></label>
                    <label>اسم الفرع بالأجنبي (Foreign Name)<input class="input" @bind="_settings.ForeignName" dir="ltr" /></label>
                    <label class="full">عنوان الفرع بالعربي (Arabic Address)<input class="input" @bind="_settings.ArabicAddress" /></label>
                    <label class="full">عنوان الفرع بالأجنبي (Foreign Address)<input class="input" @bind="_settings.ForeignAddress" dir="ltr" /></label>
                    <label>رقم الفاكس (Fax No.)<input class="input" @bind="_settings.Fax" dir="ltr" /></label>
                    <label>صندوق البريد (P.O. Box)<input class="input" @bind="_settings.PoBox" dir="ltr" /></label>
                    <label class="full">الموقع على الإنترنت (Internet Location)<input class="input" @bind="_settings.Website" placeholder="https://" dir="ltr" /></label>
                </div>
                <div class="panel-header" style="margin-top:.5rem"><h3>إعدادات الإيصال الحراري</h3></div>
                <div class="form-grid" style="padding:1rem">
                    <label class="full">رأس الإيصال (ترحيب)
                        <input class="input" @bind="_settings.ReceiptHeader" placeholder="مرحباً بكم" />
                    </label>
                    <label class="full">ذيل الإيصال (توديع)
                        <input class="input" @bind="_settings.ReceiptFooter" placeholder="شكراً لزيارتكم" />
                    </label>
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer">
                        <input type="checkbox" @bind="_settings.ShowTaxOnReceipt" />
                        إظهار الضريبة على الإيصال
                    </label>
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer">
                        <input type="checkbox" @bind="_settings.ShowQrOnReceipt" />
                        إظهار رمز QR على الإيصال
                    </label>
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer">
                        <input type="checkbox" @bind="_settings.PrintKitchenCopy" />
                        طباعة قصاصة المطبخ تلقائياً
                    </label>
                </div>
                <div class="panel-header" style="margin-top:.5rem"><h3>إعدادات نقطة البيع</h3></div>
                <div class="form-grid" style="padding:1rem">
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer" class="full">
                        <input type="checkbox" @bind="_settings.RestaurantMode" />
                        وضع المطعم (أنواع الطلبات)
                    </label>
                    <label>نوع الطلب الأول (محلي)
                        <input class="input" @bind="_settings.OrderTypeLocal" placeholder="محلي" />
                    </label>
                    <label>نوع الطلب الثاني (آمر صرف)
                        <input class="input" @bind="_settings.OrderTypeTakeaway" placeholder="آمر صرف" />
                    </label>
                    <label>نوع الطلب الثالث (توصيل)
                        <input class="input" @bind="_settings.OrderTypeDelivery" placeholder="توصيل" />
                    </label>
                </div>
                <div class="modal-actions" style="justify-content:flex-end;padding:1rem">
                    <button type="submit" class="primary-btn">💾 حفظ الإعدادات</button>
                </div>
            </EditForm>
        </div>

        <div class="panel">
            <div class="panel-header"><h3>معاينة بطاقة الشركة</h3></div>
            <div style="padding:24px;text-align:center">
                <div style="font-size:4rem">@_settings.LogoEmoji</div>
                <h2 style="margin:8px 0">@_settings.Name</h2>
                <div class="muted">@_settings.Address</div>
                <div class="muted" dir="ltr">@_settings.Phone @(string.IsNullOrEmpty(_settings.Email) ? "" : "•") @_settings.Email</div>
                <div class="muted">الرقم الضريبي: @_settings.TaxNumber • العملة: @_settings.Currency • الضريبة: @_settings.TaxRate%</div>
                @if (!string.IsNullOrWhiteSpace(_settings.ReceiptHeader))
                {
                    <div class="muted" style="margin-top:.5rem;font-style:italic">رأس الإيصال: @_settings.ReceiptHeader</div>
                }
            </div>
        </div>
    }
</div>

@code {
    private CompanySettings? _settings;
    private string _message = "";
    private string _error = "";

    protected override async Task OnInitializedAsync()
    {
        var s = await SettingsSvc.GetAsync();
        _settings = new CompanySettings
        {
            Id = s.Id,
            Name = s.Name,
            TaxNumber = s.TaxNumber,
            CommercialRegister = s.CommercialRegister,
            Phone = s.Phone,
            Email = s.Email,
            Address = s.Address,
            Currency = s.Currency,
            TaxRate = s.TaxRate,
            LogoEmoji = s.LogoEmoji,
            ReceiptHeader = s.ReceiptHeader,
            ReceiptFooter = s.ReceiptFooter,
            ShowTaxOnReceipt = s.ShowTaxOnReceipt,
            ShowQrOnReceipt = s.ShowQrOnReceipt,
            PrintKitchenCopy = s.PrintKitchenCopy,
            RestaurantMode = s.RestaurantMode,
            OrderTypeLocal = s.OrderTypeLocal,
            OrderTypeTakeaway = s.OrderTypeTakeaway,
            OrderTypeDelivery = s.OrderTypeDelivery,
            BranchCode = s.BranchCode,
            ArabicName = s.ArabicName,
            ForeignName = s.ForeignName,
            ArabicAddress = s.ArabicAddress,
            ForeignAddress = s.ForeignAddress,
            FinancialYear = s.FinancialYear,
            Fax = s.Fax,
            PoBox = s.PoBox,
            Website = s.Website,
        };
    }

    private async Task Save()
    {
        if (_settings == null) return;
        try
        {
            await SettingsSvc.SaveAsync(_settings);
            await Audit.LogAsync("تعديل إعدادات الشركة", "النظام", _settings.Name);
            _message = "✅ تم حفظ الإعدادات بنجاح";
            _error = "";
        }
        catch (AuthorizationException ex) { _error = ex.Message; _message = ""; }
    }
}
