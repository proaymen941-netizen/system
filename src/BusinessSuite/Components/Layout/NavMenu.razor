@implements IDisposable
@inject NavigationManager Nav

<aside class="sidebar">
    <div class="sidebar-brand">
        <div class="brand-logo">🌿</div>
        <div class="brand-text">
            <div class="brand-title">النظام المتكامل</div>
            <div class="brand-subtitle">إدارة الأعمال</div>
        </div>
    </div>

    <nav class="sidebar-nav">
        @foreach (var group in _groups)
        {
            <div class="nav-group-title">@group.Title</div>
            @foreach (var item in group.Items)
            {
                var active = IsActive(item.Href) ? "active" : "";
                <a class="nav-link @active" href="@item.Href">
                    <span class="nav-icon">@item.Icon</span>
                    <span class="nav-label">@item.Label</span>
                    @if (active == "active") { <span class="nav-active-bar"></span> }
                </a>
            }
        }
    </nav>

    <div class="sidebar-footer">
        <div class="db-pill">
            <span class="db-dot"></span>
            <div>
                <div class="db-title">قاعدة البيانات</div>
                <div class="db-status">SQLite — متصل</div>
            </div>
        </div>
    </div>
</aside>

@code {
    private record NavItem(string Href, string Label, string Icon);
    private record NavGroup(string Title, NavItem[] Items);

    private readonly NavGroup[] _groups = new[]
    {
        new NavGroup("الرئيسية", new[]
        {
            new NavItem("/", "لوحة التحكم", "📊"),
        }),
        new NavGroup("العمليات", new[]
        {
            new NavItem("/pos", "نقطة البيع", "🛒"),
            new NavItem("/sales", "المبيعات", "💵"),
            new NavItem("/purchases", "المشتريات", "🧾"),
            new NavItem("/customers", "العملاء", "👤"),
        }),
        new NavGroup("المخزون", new[]
        {
            new NavItem("/inventory", "المنتجات", "📦"),
            new NavItem("/stock-movements", "حركة المخزون", "🔄"),
            new NavItem("/import", "استيراد البيانات", "📥"),
        }),
        new NavGroup("المحاسبة", new[]
        {
            new NavItem("/accounting", "القيود اليومية", "💰"),
            new NavItem("/trial-balance", "ميزان المراجعة", "⚖️"),
        }),
        new NavGroup("الموارد البشرية", new[]
        {
            new NavItem("/hr", "الموظفون", "👥"),
            new NavItem("/attendance", "الحضور", "⏰"),
            new NavItem("/leaves", "الإجازات", "📋"),
        }),
        new NavGroup("التحليلات", new[]
        {
            new NavItem("/reports", "التقارير", "📈"),
        }),
        new NavGroup("النظام", new[]
        {
            new NavItem("/users", "المستخدمون", "🔐"),
            new NavItem("/my-password", "كلمة المرور", "🔑"),
            new NavItem("/audit", "سجل العمليات", "📜"),
            new NavItem("/company-settings", "إعدادات الشركة", "🏢"),
            new NavItem("/sync", "المزامنة", "☁️"),
            new NavItem("/settings", "النسخ الاحتياطي", "⚙️"),
        }),
    };

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private bool IsActive(string href)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        if (href == "/") return string.IsNullOrEmpty(path) || path == "/";
        return path.Equals(href, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
