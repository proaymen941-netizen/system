@implements IDisposable
@inject NavigationManager Nav
@inject AuthService Auth

<aside class="sidebar">
    <div class="sidebar-brand">
        <div class="brand-logo">🌿</div>
        <div class="brand-text">
            <div class="brand-title">النظام المتكامل</div>
            <div class="brand-subtitle">إدارة الأعمال</div>
        </div>
    </div>

    <nav class="sidebar-nav">
        @foreach (var group in _groups)
        {
            <div class="nav-group-title">@group.Title</div>
            @foreach (var item in group.Items)
            {
                var active = IsActive(item.Href) ? "active" : "";
                <a class="nav-link @active" href="@item.Href">
                    <span class="nav-icon">@item.Icon</span>
                    <span class="nav-label">@item.Label</span>
                    @if (active == "active") { <span class="nav-active-bar"></span> }
                </a>
            }
        }
    </nav>

    <div class="sidebar-footer">
        <div class="db-pill">
            <span class="db-dot"></span>
            <div>
                <div class="db-title">قاعدة البيانات</div>
                <div class="db-status">SQLite — متصل</div>
            </div>
        </div>
    </div>
</aside>

@code {
    private record NavItem(string Href, string Label, string Icon);
    private record NavGroup(string Title, NavItem[] Items);

    private readonly NavGroup[] _groups = new[]
    {
        new NavGroup("الرئيسية", new[]
        {
            new NavItem("/", "لوحة التحكم", "📊"),
        }),
        new NavGroup("نقطة البيع والكاشير", new[]
        {
            new NavItem("/pos", "نقطة البيع", "🛒"),
            new NavItem("/cashier-shifts", "ورديات وإقفال الكاشير", "⏱️"),
            new NavItem("/sales", "المبيعات", "💵"),
            new NavItem("/sales-returns", "مرتجع المبيعات", "↩️"),
        }),
        new NavGroup("المشتريات والعملاء", new[]
        {
            new NavItem("/purchases", "المشتريات", "🧾"),
            new NavItem("/customers", "العملاء", "👤"),
        }),
        new NavGroup("المخزون", new[]
        {
            new NavItem("/inventory", "المنتجات", "📦"),
            new NavItem("/warehouses", "المخازن", "🏬"),
            new NavItem("/stock-movements", "حركة المخزون", "🔄"),
            new NavItem("/stock-issues", "سند صرف مخزني", "📤"),
            new NavItem("/import", "استيراد البيانات", "📥"),
        }),
        new NavGroup("المحاسبة", new[]
        {
            new NavItem("/chart-of-accounts", "شجرة الحسابات", "🌳"),
            new NavItem("/manual-journal", "إدخال القيود", "📝"),
            new NavItem("/accounting", "القيود اليومية", "💰"),
            new NavItem("/vouchers/receipt", "سند قبض نقدي", "📥"),
            new NavItem("/vouchers/payment", "سند صرف نقدي", "📤"),
            new NavItem("/custodies", "العهد والأرصدة", "💼"),
            new NavItem("/account-statements", "كشوف الحسابات", "📋"),
            new NavItem("/trial-balance", "ميزان المراجعة", "⚖️"),
        }),
        new NavGroup("الموارد البشرية", new[]
        {
            new NavItem("/hr", "بيانات الموظفين", "👥"),
            new NavItem("/employee-statement", "كشف حساب الموظف", "🧾"),
            new NavItem("/penalties-rewards", "الجزاءات والمكافآت", "⚖️"),
            new NavItem("/monthly-absence", "الغياب الشهري", "📅"),
            new NavItem("/installments", "الأقساط", "💳"),
            new NavItem("/attendance", "الحضور", "⏰"),
            new NavItem("/leaves", "الإجازات", "📋"),
        }),
        new NavGroup("الصيانة والتقارير", new[]
        {
            new NavItem("/maintenance", "طلبات الصيانة", "🔧"),
            new NavItem("/department-sales", "مبيعات حسب القسم", "🏷️"),
            new NavItem("/reports", "التقارير", "📈"),
        }),
        new NavGroup("النظام والتراخيص", new[]
        {
            new NavItem("/license", "إدارة التراخيص", "🔐"),
            new NavItem("/permissions", "الصلاحيات", "🛡️"),
            new NavItem("/users", "المستخدمون", "👤"),
            new NavItem("/my-password", "كلمة المرور", "🔑"),
            new NavItem("/audit", "سجل العمليات", "📜"),
            new NavItem("/company-settings", "بيانات الشركة", "🏢"),
            new NavItem("/branches", "الفروع", "🏛️"),
            new NavItem("/currencies", "العملات", "💱"),
            new NavItem("/sessions", "جلسات المستخدمين", "🟢"),
            new NavItem("/sync", "المزامنة", "☁️"),
            new NavItem("/settings", "النسخ الاحتياطي", "⚙️"),
        }),
    };

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private bool IsActive(string href)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        if (href == "/") return string.IsNullOrEmpty(path) || path == "/";
        return path.Equals(href, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
